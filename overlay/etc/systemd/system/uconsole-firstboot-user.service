[Unit]
Description=uConsole first-boot account setup
ConditionPathExists=!/var/lib/uconsole-firstboot-done
# Own the console before the autologin getty starts, so the prompt is visible
# and the getty picks up the rewritten autologin user afterwards.
Before=getty@tty1.service
After=systemd-user-sessions.service plymouth-quit-wait.service

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/usr/local/bin/uconsole-firstboot-user
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
