#!/usr/bin/env bash
# Toggle the panel backlight. Bound to a short power-key press.
#
# Going down it also locks the session and silences the keyboard and trackball,
# so the device can sit in a bag without stray keypresses reaching whatever was
# on screen. Coming back up it restores everything and swaylock asks for the
# password.
#
# It also POWERS THE PANEL DOWN, not just its backlight. Measured on this
# hardware: backlight 2.08 W, panel and controller a further 0.70 W.
#
# Report S3.8 said the DSI panel "never wakes from dpms off" and this script
# avoided touching it for exactly that reason. S3.8 was wrong: the panel powers
# down and comes back fine. What genuinely did not work was sway RE-ENABLING the
# output, and why took a while to find -- each of `power on`, `enable` and `mode`
# returns {"success": true} and changes nothing ON ITS OWN. Issued as a PAIR,
# `power on` then `enable`, the output comes back every time. See panel_on_ipc.
set -uo pipefail
STATE=/run/user/$(id -u)/uconsole-backlight.save
MUTESTATE=/run/user/$(id -u)/uconsole-mute.save
PANELSTATE=/run/user/$(id -u)/uconsole-panel.save
CONF=/etc/uconsole/lowpower.conf

MUTE_ON_BLANK=1
# shellcheck source=/dev/null
[[ -r $CONF ]] && . "$CONF"

# Which output is the panel? Do not hardcode DSI-2 -- read it back, so a
# renamed connector does not silently disable the whole feature.
panel_output() {
    command -v swaymsg >/dev/null 2>&1 || return 0
    swaymsg -t get_outputs -r 2>/dev/null | python3 -c '
import json, sys
try:
    for o in json.load(sys.stdin):
        if o.get("name"): print(o["name"]); break
except Exception:
    pass' 2>/dev/null
}

# Is the panel actually being driven? DRM is the authority, not sway's own flag.
#
# Measured 2026-09-12: after a VT bounce sway reports "power": false while the
# connector is enabled with DPMS On -- the panel is lit and sway disagrees.
# Asking sway alone therefore reports a working panel as broken and provokes
# another needless restore. Fall back to sway only if no connector can be read.
panel_is_on() {
    local c
    for c in /sys/class/drm/card*-DSI-*; do
        [[ -r $c/enabled && -r $c/dpms ]] || continue
        [[ $(cat "$c/enabled") == enabled && $(cat "$c/dpms") == On ]] && return 0
        return 1
    done
    [[ $(swaymsg -t get_outputs -r 2>/dev/null | grep -c '"power": true') -gt 0 ]]
}

# Bring the panel back over sway IPC: no root, no VT switch.
#
# Measured 2026-09-12 on this hardware, 3/3 cycles, each showing the panel
# re-initialise in dmesg (rp1dsi byte/DPI clocks, then "regulator iovcc and vci
# defined, enabling"). The ORDER is the whole trick, and is why this was thought
# impossible:
#
#     power on             alone -> 0/3, connector stays disabled/Off
#     enable               alone -> 0/3, connector stays disabled/Off
#     power on THEN enable       -> 3/3, connector enabled/On
#
# The reading that fits: `power on` sets the desired DPMS state without
# committing anything, and `enable` forces the output reconfigure that applies
# it. Earlier notes tried all three commands SEPARATELY, found each returned
# success and changed nothing, and concluded sway could not do it at all. The
# pair was never tried.
panel_on_ipc() {
    local out=$1
    swaymsg output "$out" power on >/dev/null 2>&1
    swaymsg output "$out" enable   >/dev/null 2>&1
    sleep 1
    panel_is_on
}

# Hand the privileged half off to uconsole-lowpower. This script runs as the
# logged-in user from a sway binding, so it cannot touch rfkill, cpufreq or CPU
# hotplug directly, and a key binding has nowhere to prompt for a password --
# hence `sudo -n` plus a sudoers drop-in scoped to this one binary.
#
# Never fatal. If the privileged half is missing or sudo refuses, the screen
# still blanks and still locks; we just save less power and say so in the log.
# Never probe with a DIFFERENT command than the one you intend to run.
#
# This previously tested `sudo -n true` first. The sudoers drop-in grants
# NOPASSWD for /usr/local/bin/uconsole-lowpower and nothing else, so sudo
# answered "a password is required" for /usr/bin/true, the guard failed, and the
# whole descent was skipped -- silently, on a machine whose screen is off. The
# blank still blanked and still locked, so it looked like it worked; it just
# saved nothing but the backlight. Run the real command and judge by its result.
lowpower() {
    [[ -x /usr/local/bin/uconsole-lowpower ]] || return 0
    if [[ $EUID -eq 0 ]]; then
        /usr/local/bin/uconsole-lowpower "$1" >/dev/null 2>&1 && return 0
    else
        sudo -n /usr/local/bin/uconsole-lowpower "$1" >/dev/null 2>&1 && return 0
    fi
    logger -t uconsole-screen-toggle "WARNING: 'lowpower $1' failed -- no passwordless sudo, or the helper errored"
    return 0
}

cur=$(brightnessctl get 2>/dev/null || echo 0)
max=$(brightnessctl max 2>/dev/null || echo 0)

# Emit sway input identifiers.
#
# mode=pointers deliberately covers ONLY pointer-like devices, never keyboards.
# The power key arrives as a keyboard-type device, and its identifier is not
# something this script can reliably predict -- disabling keyboards risked
# silencing the one device that can bring the machine back. Keyboard input is
# not a real hazard anyway: while swaylock holds the session, keystrokes go to
# the password prompt and cannot reach whatever was on screen. The trackball is
# the input that actually matters here, since a ball rolling in a bag is what
# generates spurious events.
list_inputs() {
    command -v swaymsg >/dev/null 2>&1 || return 0
    swaymsg -t get_inputs -r 2>/dev/null | python3 -c '
import json, sys
mode = sys.argv[1] if len(sys.argv) > 1 else "all"
POINTERS = ("pointer", "touchpad", "touch", "tablet_tool")
ALL = POINTERS + ("keyboard",)
try:
    devs = json.load(sys.stdin)
except Exception:
    sys.exit(0)
wanted = POINTERS if mode == "pointers" else ALL
for d in devs:
    if d.get("type") in wanted:
        print(d.get("identifier", ""))
' "$1" 2>/dev/null
}

set_inputs() {   # $1 = enabled|disabled   $2 = all|pointers
    local ident
    while read -r ident; do
        [[ -n $ident ]] && swaymsg input "$ident" events "$1" >/dev/null 2>&1
    done < <(list_inputs "$2")
}

lock_session() {
    command -v swaylock >/dev/null 2>&1 || {
        logger -t uconsole-screen-toggle "WARNING: swaylock not installed; blanking WITHOUT locking"
        return 0
    }
    pgrep -x swaylock >/dev/null 2>&1 && return 0
    # -f daemonises; without it this script would block until unlocked and the
    # backlight would never go off.
    if ! swaylock -f -c 000000 >/dev/null 2>&1; then
        logger -t uconsole-screen-toggle "WARNING: swaylock failed to start; screen blanked WITHOUT locking"
    fi
}

if [[ ${cur:-0} -gt 0 ]]; then
    echo "$cur" > "$STATE" 2>/dev/null || true
    # Lock before blanking so the desktop is never briefly visible on wake.
    lock_session
    set_inputs disabled pointers

    # Record whether WE muted, not what the mute state was.
    #
    # The previous version saved the prior state and replayed it on wake. That
    # can latch: once anything leaves the sink muted, the next descent records
    # "was muted", the next wake dutifully re-mutes, and the machine is silent
    # forever with every cycle looking correct. Recording our own action cannot
    # latch -- if we did not mute it, we do not touch it.
    #
    # `grep -c`, never `grep -q`: with `set -o pipefail`, grep -q exits on the
    # first match and SIGPIPEs wpctl, which marks the whole pipeline failed and
    # inverts the result. That exact bug has bitten this repo three times.
    if [[ ${MUTE_ON_BLANK:-1} == 1 ]] && command -v wpctl >/dev/null 2>&1; then
        if [[ $(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -c MUTED || true) -gt 0 ]]; then
            echo 0 > "$MUTESTATE"          # already muted by the user; leave it alone
        else
            echo 1 > "$MUTESTATE"          # we are muting, so we must unmute on wake
            wpctl set-mute @DEFAULT_AUDIO_SINK@ 1 >/dev/null 2>&1
        fi
    fi

    brightnessctl set 0 >/dev/null 2>&1

    # Power the panel down, not just its backlight.
    #
    # Measured on this hardware: the backlight is 2.08 W and the panel plus its
    # controller are a FURTHER 0.70 W, which every previous version of this
    # script left running. That 0.70 W is the single largest saving in the whole
    # low-power path.
    #
    # This was avoided for years on the strength of report S3.8 -- "the DSI panel
    # never wakes from dpms off". That was wrong. The panel powers down and comes
    # back perfectly; what never worked was sway RE-ENABLING the output. See the
    # wake branch.
    # Default 0 when the conf does not say: the restore is the risky half, and a
    # conf from before this option must not switch it on.
    if [[ ${PANEL_OFF_ON_BLANK:-0} == 1 ]]; then
        _out=$(panel_output)
        if [[ -n ${_out:-} ]]; then
            swaymsg output "$_out" power off >/dev/null 2>&1
            echo "$_out" > "$PANELSTATE" 2>/dev/null || true
        fi
    fi

    lowpower down
    logger -t uconsole-screen-toggle "blanked, locked, pointer input silenced, low-power engaged"
else
    # Re-enable EVERY input, not just what we silenced. If anything went wrong on
    # the way down, this is the path that has to recover it -- an input left
    # disabled with no keyboard is unrecoverable without a reboot.
    # Panel first: everything else is invisible until the screen is back.
    #
    # sway CAN power this output back on, as of 2026-09-12: `power on` then
    # `enable` restores it 3/3, with no VT switch and no root. See panel_on_ipc
    # for why the order matters and why this was believed impossible.
    #
    # The VT bounce is kept only as a fallback. It is the one path that works
    # without a live compositor socket, but it needs DRM master, it leaves sway's
    # own "power" flag disagreeing with the connector, and driven unattended it
    # once stranded the session on another VT.
    if [[ -f $PANELSTATE ]]; then
        _out=$(cat "$PANELSTATE" 2>/dev/null)
        [[ -n ${_out:-} ]] || _out=$(panel_output)
        # Record WHICH path restored it. A silent success is not good enough here:
        # after the first end-to-end cycle the only evidence that IPC had worked
        # was the absence of a fallback message, which is inference, not a
        # measurement -- and it is exactly the thing to check if this ever
        # regresses.
        _how=""
        for _try in 1 2; do
            panel_is_on && { _how=${_how:-already on}; break; }
            [[ -n ${_out:-} ]] && panel_on_ipc "$_out" && { _how="sway IPC (power on + enable), try $_try"; break; }
            sleep 1
        done
        # Only if IPC could not do it: regain DRM master the hard way.
        panel_is_on || { lowpower panel-on; sleep 1; _how="VT bounce fallback"; }
        if panel_is_on; then
            rm -f "$PANELSTATE"
            logger -t uconsole-screen-toggle "panel restored by ${_how:-unknown path}"
        else
            logger -t uconsole-screen-toggle "ERROR: panel did not come back; recover with Ctrl+Alt+F2 then Ctrl+Alt+F1"
        fi
    fi

    set_inputs enabled all
    if [[ -r $STATE ]]; then
        brightnessctl set "$(cat "$STATE")" >/dev/null 2>&1
    else
        brightnessctl set "$(( max * 40 / 100 ))" >/dev/null 2>&1
    fi

    # Screen and input first, hardware second: whatever else fails, the user gets
    # a visible, responsive machine back.
    lowpower up

    if command -v wpctl >/dev/null 2>&1; then
        # Unmute unless we explicitly recorded that the user had already muted.
        # A missing or unreadable state file means UNMUTE: a machine left silent
        # with no record of why is the worse failure, and this is the branch that
        # has to clean up after a descent that died halfway.
        if [[ $(cat "$MUTESTATE" 2>/dev/null || echo 1) != 0 ]]; then
            wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 >/dev/null 2>&1
        fi
        rm -f "$MUTESTATE"
    fi

    logger -t uconsole-screen-toggle "woken, input and low-power state restored"
fi
