# Sway configuration for ClockworkPi uConsole (Raspberry Pi CM5)
#
# The uConsole keyboard has no Super key, so Alt is the modifier throughout.

### Variables
set $mod Mod1
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu fuzzel

### Output
# The panel is 1280x720 on 5 inches (~294 PPI), so unscaled text is unreadable.
#
# Scale is 1.25, not 1.2, on purpose: 1280/1.25 = 1024 and 720/1.25 = 576, both
# whole numbers. A fractional scale that does not divide evenly (1280/1.2 =
# 1066.67) leaves a partial pixel column at the right edge, which is the most
# likely source of the cursor residue seen there. Other clean options are
# 1.6 (800x450) and 2.0 (640x360) if you want larger text.
output DSI-2 scale 1.25
# Plain black desktop.
output * bg #000000 solid_color

### Appearance
# No title bars and no borders anywhere.
default_border none
default_floating_border none
titlebar_border_thickness 0
titlebar_padding 1
font pango:monospace 9
gaps inner 0
gaps outer 0

### Windows open filling the screen
# Note: a fullscreen window covers waybar too. Comment this line out if you
# would rather see the status bar; a single window already fills the workspace.
for_window [app_id=".*"] fullscreen enable
for_window [class=".*"] fullscreen enable

### Input
input type:keyboard {
    xkb_options ctrl:nocaps
    repeat_delay 300
    repeat_rate 30
}

# Trackball. It has no scroll wheel, so holding the right button and rolling
# scrolls. 'flat' acceleration suits a trackball better than the adaptive
# profile, which makes slow precise movement feel sticky.
input type:pointer {
    accel_profile flat
    pointer_accel 0.4
    scroll_method on_button_down
    scroll_button button3
    scroll_factor 1.5
    natural_scroll disabled
    middle_emulation enabled
}

### Key bindings
bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym $mod+d exec $menu
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'
floating_modifier $mod normal

# Focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# Workspaces 1-10. Workspace 10 is on the 0 key, following the usual convention
# that the number row reads 1..9 then 0.
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Screenshot
bindsym Print exec grim -g "$(slurp)" ~/screenshot-$(date +%Y%m%d-%H%M%S).png

### Hardware keys
bindsym --locked XF86MonBrightnessUp exec brightnessctl set +10%
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 10%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Power key. Tap to blank and lock; hold ~2s for a clean poweroff, which fires
# WHILE the key is still down so you feel it start. logind is set to ignore the
# key so the compositor sees it at all.
#
# THREE poweroff paths exist, shortest first, and the shorter ones do not remove
# the longer ones:
#
#   ~2s  here, a sway timer that re-checks the key state -> clean poweroff
#    5s  logind's HandlePowerKeyLongPress                -> clean poweroff
#   10s  the AXP223 cutting power in hardware            -> UNCLEAN, last resort
#
# 5s is a compile-time constant in logind with no setting in any systemd version
# (systemd#28100 is the open request), and the AXP223's register offers only
# 4/6/8/10s -- parked at 10s deliberately, since a clean shutdown takes about 8s
# from the press and anything shorter would cut power mid-unmount. Measuring the
# hold here is the only way to get anything shorter.
#
# The press binding arms a timer. That is only safe because the timer does not
# trust the release event: when it expires it asks the KERNEL whether the key is
# still physically held (evtest --query), so a tap cannot power the machine off
# even if the release binding is missed entirely. Every failure -- no device,
# evtest missing, query fails, key already up -- lands on doing nothing, leaving
# logind's 5s exactly as it was.
#
# --no-repeat: without it sway fires the binding at the 30/s repeat rate while
# the key is held, which strobed the backlight through a long press.
# --locked: without it sway refuses to run a binding while swaylock is up, and
# the power key stopped working the moment the screen locked -- no way back.
#
# Suspend is deliberately NOT used, and not for the reason an earlier version of
# this comment gave. That version claimed the kernel registered nothing of the
# sort; on this build it registers two. /sys/power/mem_sleep reads "s2idle [deep]", so a
# reader who checks sysfs will conclude this warning is obsolete. It is not:
#
#   deep    is not suspend-to-RAM on BCM2712. Broadcom never shipped the DDR
#           self-refresh sequences, so what PSCI advertises is a firmware test
#           stub that parks the ARM core for about a second.
#   s2idle  is a real kernel state, but its device-suspend phase reliably wedges
#           the SDIO-attached Broadcom Wi-Fi chip on this board (-110 backplane
#           timeouts), and a driver reload does not recover it -- only a reboot.
#
# Five attempts, five hard hangs, two dirty filesystems. The sleep targets are
# masked in this image and mem_sleep_default=s2idle is pinned on the kernel
# command line so a bare `echo mem` cannot reach the firmware stub. See
# docs/HARDWARE.md S3.9.
bindsym --no-repeat --locked XF86PowerOff exec /usr/local/bin/uconsole-powerkey-hold press
bindsym --no-repeat --release --locked XF86PowerOff exec /usr/local/bin/uconsole-powerkey-hold release

### Idle behaviour
# Dim the BACKLIGHT only. No suspend, no lock, no power-off: the screen dims,
# the machine keeps running, and any key or trackball movement brings it
# straight back.
#
# The power-button blank (uconsole-screen-toggle) goes further and powers the
# DSI panel down, restoring it with `output ... power on` then `enable`. The old
# S3.8 note that the panel "never comes back from dpms off" was sway being asked
# with one of those commands instead of both. A resume here would need that same
# restore, so the idle path keeps to the backlight.
exec swayidle -w \
    timeout 300 'brightnessctl -s set 0' \
    resume    'brightnessctl -r'

### Session restore
# There is no suspend on this hardware, so the way back from a poweroff is to
# relaunch what was open. The restore runs FIRST and takes a lock; the snapshot
# daemon skips writing while that lock is held, so it cannot capture the
# half-restored desktop and overwrite the very file it is being restored from.
#
# Plain `exec`, not a systemd user unit: these need SWAYSOCK and WAYLAND_DISPLAY,
# and nothing in this image runs dbus-update-activation-environment to put them
# in the user manager's environment. An exec inherits them and dies with sway.
exec /usr/local/bin/uconsole-session-restore
exec /usr/local/bin/uconsole-session-snapshot

### Bar
bar {
    swaybar_command waybar
}

include /etc/sway/config.d/*
