# Sway configuration for ClockworkPi uConsole (Raspberry Pi CM5)
#
# The uConsole keyboard has no Super key, so Alt is the modifier throughout.

### Variables
set $mod Mod1
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu fuzzel

### Output
# The panel is 1280x720 on 5 inches (~294 PPI), so unscaled text is unreadable.
#
# Scale is 1.25, not 1.2, on purpose: 1280/1.25 = 1024 and 720/1.25 = 576, both
# whole numbers. A fractional scale that does not divide evenly (1280/1.2 =
# 1066.67) leaves a partial pixel column at the right edge, which is the most
# likely source of the cursor residue seen there. Other clean options are
# 1.6 (800x450) and 2.0 (640x360) if you want larger text.
output DSI-2 scale 1.25
# Plain black desktop.
output * bg #000000 solid_color

### Appearance
# No title bars and no borders anywhere.
default_border none
default_floating_border none
titlebar_border_thickness 0
titlebar_padding 1
font pango:monospace 9
gaps inner 0
gaps outer 0

### Windows open filling the screen
# Note: a fullscreen window covers waybar too. Comment this line out if you
# would rather see the status bar; a single window already fills the workspace.
for_window [app_id=".*"] fullscreen enable
for_window [class=".*"] fullscreen enable

### Input
input type:keyboard {
    xkb_options ctrl:nocaps
    repeat_delay 300
    repeat_rate 30
}

# Trackball. It has no scroll wheel, so holding the right button and rolling
# scrolls. 'flat' acceleration suits a trackball better than the adaptive
# profile, which makes slow precise movement feel sticky.
input type:pointer {
    accel_profile flat
    pointer_accel 0.4
    scroll_method on_button_down
    scroll_button button3
    scroll_factor 1.5
    natural_scroll disabled
    middle_emulation enabled
}

### Key bindings
bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym $mod+d exec $menu
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'
floating_modifier $mod normal

# Focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# Workspaces 1-10. Workspace 10 is on the 0 key, following the usual convention
# that the number row reads 1..9 then 0.
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Screenshot
bindsym Print exec grim -g "$(slurp)" ~/screenshot-$(date +%Y%m%d-%H%M%S).png

### Hardware keys
bindsym XF86MonBrightnessUp exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Power key: short press blanks the backlight (logind is set to ignore it so the
# compositor sees it); a ~5s long press is a clean poweroff, handled by logind.
# Suspend is not used -- see S3.9, the kernel registers no sleep states.
bindsym XF86PowerOff exec /usr/local/bin/uconsole-screen-toggle

### Idle behaviour
# Dim the BACKLIGHT rather than powering the panel down.
#
# Report S3.8: on this cwu50 DSI panel, `output dpms off` was observed never to
# come back -- no keyboard or trackball input revived it, and it presents as a
# completely hung machine. The kernel log showed the panel re-enable never
# firing. Driving the backlight avoids the DSI power-down entirely, is instant,
# and cannot strand you at a black screen.
#
# No suspend, no lock, no power-off: the screen dims, the machine keeps running,
# and any key or trackball movement brings it straight back.
exec swayidle -w \
    timeout 300 'brightnessctl -s set 0' \
    resume    'brightnessctl -r'

### Bar
bar {
    swaybar_command waybar
}

include /etc/sway/config.d/*
