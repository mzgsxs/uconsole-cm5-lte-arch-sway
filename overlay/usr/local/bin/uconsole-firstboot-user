#!/usr/bin/env bash
# First-boot account setup for the uConsole image.
#
# Prompts for a username and password, creates that account as the primary
# administrator, and gives root and the stock 'alarm' account the same
# password. There is no autologin: the machine requires a login at every boot.
#
# Deliberately not 'set -e': every failure path here re-prompts rather than
# aborting, because aborting would leave a machine nobody can log into.
set -uo pipefail

STAMP=/var/lib/uconsole-firstboot-done
NEWGROUPS=wheel,video,audio,input,render,storage,network
DROPIN=/etc/systemd/system/getty@tty1.service.d/autologin.conf

[[ -e $STAMP ]] && exit 0
[[ -t 0 ]] || { echo "firstboot: no terminal, skipping"; exit 0; }

# ---------------------------------------------------------------------------
# Take sole ownership of the console while we prompt.
#
# Two things otherwise scribble over the prompt: kernel printk (cmdline.txt has
# console=tty1, so KERN_ERR and worse land here) and systemd's own
# "[ OK ] Started ..." status lines. Both are silenced only for the duration of
# the wizard and restored on exit, so a boot that goes wrong later still prints
# diagnostics to the panel -- which matters on a machine whose only display is
# this one.
# ---------------------------------------------------------------------------
SAVED_PRINTK=""
SYSTEMD_QUIETED=0
SAVED_VT=""
# cmdline.txt sets console=tty1, so every kernel printk lands on tty1 no matter
# how quiet we ask it to be. Rather than compete for that console, run the
# wizard on a VT the kernel never writes to. Only tty1 has a getty, so 7 is free.
WIZARD_VT=7

console_quiet() {
    # /proc/sys/kernel/printk holds four values; the first is console_loglevel.
    # Save and restore only that one, so the write is an unambiguous integer.
    SAVED_PRINTK="$(awk '{print $1}' /proc/sys/kernel/printk 2>/dev/null || true)"
    echo 1 > /proc/sys/kernel/printk 2>/dev/null || true
    # SIGRTMIN+21 tells PID 1 to stop emitting status messages to the console.
    if kill -s RTMIN+21 1 2>/dev/null; then SYSTEMD_QUIETED=1; fi
    # Belt and braces: stop this specific console accepting kernel messages.
    setterm --msg off 2>/dev/null || true
    # Switch the user to our own VT. This is the fix that actually works: the
    # printk silencing above only lowers the volume, whereas tty7 is somewhere
    # the kernel does not write at all.
    SAVED_VT="$(fgconsole 2>/dev/null || echo 1)"
    chvt "$WIZARD_VT" 2>/dev/null || true
    clear 2>/dev/null || printf '\033[2J\033[H'
}

console_restore() {
    if [[ -n $SAVED_PRINTK ]]; then
        echo "$SAVED_PRINTK" > /proc/sys/kernel/printk 2>/dev/null || true
    fi
    setterm --msg on 2>/dev/null || true
    (( SYSTEMD_QUIETED )) && kill -s RTMIN+20 1 2>/dev/null || true
    # Hand the screen back to tty1, where the login prompt lives.
    chvt "${SAVED_VT:-1}" 2>/dev/null || true
}
trap console_restore EXIT

console_quiet

printf '\n'
printf '  ==========================================\n'
printf '   uConsole  -  Arch Linux + Sway\n'
printf '   First boot: create your account\n'
printf '  ==========================================\n\n'
printf '  This account will have sudo access.\n'
printf '  The same password is also applied to root\n'
printf '  and to the stock "alarm" account.\n\n'

USERNAME=""
while [[ -z $USERNAME ]]; do
    read -r -p '  Username: ' USERNAME
    if [[ ! $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
        printf '  ! Use lowercase letters, digits, - and _ (must not start with a digit).\n\n'
        USERNAME=""; continue
    fi
    if id "$USERNAME" &>/dev/null; then
        printf '  ! That account already exists. Pick another name.\n\n'
        USERNAME=""; continue
    fi
done

PASSWORD=""
while [[ -z $PASSWORD ]]; do
    read -r -s -p '  Password: ' PASSWORD; printf '\n'
    if [[ -z $PASSWORD ]]; then
        printf '  ! Password cannot be empty.\n\n'; continue
    fi
    read -r -s -p '  Repeat password: ' PASSWORD2; printf '\n'
    if [[ $PASSWORD != "$PASSWORD2" ]]; then
        printf '  ! Passwords do not match.\n\n'; PASSWORD=""; continue
    fi
done
printf '\n'

printf '  Creating %s ... ' "$USERNAME"
if ! useradd -m -G "$NEWGROUPS" -s /bin/bash "$USERNAME"; then
    printf 'FAILED\n  ! Could not create the account. Dropping to the stock login.\n'
    exit 1
fi
printf 'done\n'

# chpasswd splits on the FIRST colon, so a password containing ':' is safe.
set_pw() {
    local acct="$1"
    id "$acct" &>/dev/null || return 0
    if printf '%s:%s\n' "$acct" "$PASSWORD" | chpasswd 2>/tmp/firstboot-pw.err; then
        printf '  Password set for %s\n' "$acct"
    else
        printf '  ! Could not set password for %s: %s\n' "$acct" "$(cat /tmp/firstboot-pw.err)"
    fi
}
set_pw "$USERNAME"
set_pw root
set_pw alarm
rm -f /tmp/firstboot-pw.err

# No autologin: the machine requires a login at every boot. Remove any drop-in
# left by an earlier image so an upgrade does not silently keep autologin on.
if [[ -f $DROPIN ]]; then
    rm -f "$DROPIN"
    rmdir "$(dirname "$DROPIN")" 2>/dev/null || true
    systemctl daemon-reload
    printf '  Removed a stale autologin override; this machine requires a login.\n'
fi

install -d "$(dirname "$STAMP")"
printf 'user=%s\ndate=%s\n' "$USERNAME" "$(date -Iseconds)" > "$STAMP"

printf '\n  Account ready. Log in as %s at the prompt.\n\n' "$USERNAME"
sleep 2
