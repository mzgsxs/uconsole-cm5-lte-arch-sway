[Unit]
Description=uConsole first-boot account setup
ConditionPathExists=!/var/lib/uconsole-firstboot-done
# Run before the login getty so the prompt is visible and the account exists by
# the time anyone is asked to log in. Uses tty7 rather than tty1: cmdline.txt
# sets console=tty1, so tty1 receives every kernel printk and the prompt would
# be scribbled over.
Before=getty@tty1.service
After=systemd-user-sessions.service plymouth-quit-wait.service

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/usr/local/bin/uconsole-firstboot-user
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
