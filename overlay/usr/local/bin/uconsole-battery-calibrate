#!/usr/bin/env bash
# uconsole-battery-calibrate {status|run|report|soc|apply|abort}
#
# On-demand fuel-gauge calibration for the uConsole's AXP223 PMIC.
#
# Why this exists (report S3.5): the gauge ships uncalibrated -- 'calibrate'
# reads 0 -- and its percentage is badly wrong. Measured on this hardware it
# read 49% at 3.402 V, and 71% roughly an hour before an undervoltage cut.
# Percentages from this gauge cannot be trusted for anything.
#
# What this does: measures the pack by integrating current over a controlled
# discharge, so you get a real Wh figure and a voltage->state-of-charge table
# derived from your actual cell rather than the driver's defaults. Where the
# driver exposes writable calibration attributes, 'apply' writes them.
#
# Safety: discharge STOPS at a floor safely above the PMU cutoff (default
# 3.50 V, while uconsole-battery-guard shuts down at 3.40 V). It never runs the
# pack flat, because on this board an LTE transmit burst at low voltage crosses
# the cutoff instantly.
set -uo pipefail

# Numbers must parse and print identically whatever locale the shell inherited.
# EPOCHREALTIME's decimal separator, `read -t`'s fractional timeout, `sort -n`
# and awk all follow LC_NUMERIC, and the sample loop below leans on all four.
export LC_ALL=C

B=${B:-/sys/class/power_supply/axp20x-battery}
AC=${AC:-/sys/class/power_supply/axp22x-ac/online}
DIR=/var/lib/uconsole/battery-calibration
CSV="$DIR/discharge.csv"
META="$DIR/run.meta"
FLOOR_UV=${FLOOR_UV:-3500000}     # stop discharging here (guard cuts at 3.40 V)
# How often phase 2 samples.
#
# Measured on this board: the four sysfs reads cost 5.8 ms, nearly all of it CPU,
# because the AXP223 hangs off a bit-banged I2C bus. At 1 s that is 0.6% of one
# core -- a few mW against a ~3.3 W idle draw, far below the accuracy of what is
# being measured. What made 10 s look necessary was the loop around those reads:
# it forked about nine processes per sample. It now forks none, so the rate is
# limited by the reads alone.
#
# Sub-second values work; timestamps are taken to the millisecond, so the
# integration stays right whatever the interval.
SAMPLE_SEC=${SAMPLE_SEC:-1}

say()  { printf '\n\033[1m%s\033[0m\n' "$*"; }
inf()  { printf '      %s\n' "$*"; }
ok()   { printf '  \033[32mOK\033[0m  %s\n' "$*"; }
warn() { printf '  \033[33m!!\033[0m  %s\n' "$*"; }
err()  { printf '  \033[31mXX\033[0m  %s\n' "$*" >&2; }

need_root(){ [[ $EUID -eq 0 ]] || { err "'$1' needs root -- use sudo"; exit 1; }; }
rd(){ cat "$B/$1" 2>/dev/null || echo ""; }
on_ac(){ local s; IFS= read -r s < "$AC" 2>/dev/null || s=0; [[ $s == 1 ]]; }
uv2v(){ printf '%d.%03d' $(( ${1:-0} / 1000000 )) $(( ${1:-0} % 1000000 / 1000 )); }

# Fork-free forms, for the sample loop. `rd` costs a fork and the old awk-based
# uv2v cost two -- invisible at one sample per ten seconds, dominant at one per
# second (see SAMPLE_SEC). These read into a named variable instead of stdout.
rdv(){ unset -v "$1"; IFS= read -r "$1" < "$B/$2" 2>/dev/null || printf -v "$1" ''; }
now_ms(){ local __t=${EPOCHREALTIME//[^0-9]/}; printf -v "$1" '%s' $(( 10#${__t:0:${#__t}-3} )); }

[[ -d $B ]] || { err "no battery at $B -- is this a uConsole?"; exit 1; }
[[ -n ${EPOCHREALTIME-} ]] || { err "bash 5.0 or newer required"; exit 1; }

# SAMPLE_SEC may be fractional; the sample loop works in integer milliseconds.
_s=${SAMPLE_SEC%%.*}; _f=0; [[ $SAMPLE_SEC == *.* ]] && _f=${SAMPLE_SEC#*.}
_f=${_f}000
SAMPLE_MS=$(( 10#${_s:-0} * 1000 + 10#${_f:0:3} ))
(( SAMPLE_MS > 0 )) || SAMPLE_MS=1000
unset _s _f

modem_is_on(){ grep -qs 1e0e /sys/bus/usb/devices/*/idVendor 2>/dev/null; }

# Is the pack charged? Do NOT just test status == "Full".
#
# This driver never reports it. Measured 2026-09-10 with the pack sitting at
# 4.213 V (above the 4.200 V design maximum), gauge at 100 %, and charge current
# tapered to 4-19 mA: status still read "Charging", indefinitely. Phase 1 waited
# on that string and hung forever on a battery that was already full.
#
# Terminate on the physics instead, which is how a CV charger finishes anyway:
# at the voltage ceiling with the current fallen to a trickle. TAPER_UA is
# deliberately generous -- 150 mA is C/46 on a 7000 mAh pack, far below any real
# charging current but well above the sensor noise floor.
TAPER_UA=${TAPER_UA:-150000}
fully_charged(){
    local st v i c vmax
    st=$(rd status)
    [[ $st == "Full" ]] && { CHARGED_WHY="driver reports Full"; return 0; }
    c=$(rd capacity); v=$(rd voltage_now); i=$(rd current_now); vmax=$(rd voltage_max_design)
    [[ -z $v || -z $i ]] && return 1
    i=${i#-}                                   # magnitude; sign convention varies
    [[ -z $vmax ]] && vmax=4200000
    if (( c >= 99 )) && (( v >= vmax - 50000 )) && (( i < TAPER_UA )); then
        CHARGED_WHY="$(uv2v "$v") V at ${c}% with $((i/1000)) mA -- CV taper complete"
        return 0
    fi
    return 1
}

show_status(){
    say "Fuel gauge state"
    printf '      %-22s %s\n' "voltage" "$(uv2v "$(rd voltage_now)") V"
    printf '      %-22s %s\n' "current" "$(uv2v "$(rd current_now)") A"
    printf '      %-22s %s\n' "gauge says" "$(rd capacity)%"
    printf '      %-22s %s\n' "status" "$(rd status)"
    printf '      %-22s %s\n' "on AC" "$(on_ac && echo yes || echo no)"
    say "Calibration-relevant attributes"
    local a
    for a in calibrate charge_full charge_full_design charge_now energy_full \
             energy_full_design constant_charge_current voltage_min_design voltage_max_design; do
        if [[ -e $B/$a ]]; then
            printf '      %-26s %-12s %s\n' "$a" "$(rd "$a")" \
                "$([[ -w $B/$a ]] && echo '(writable)' || echo '(read-only)')"
        else
            printf '      %-26s %s\n' "$a" "absent"
        fi
    done
    if [[ $(rd calibrate) == 0 ]]; then
        warn "calibrate reads 0 -- the gauge has never been calibrated"
    fi
    say "Cross-check: does the voltage agree with the percentage?"
    local v pct approx
    v=$(rd voltage_now); pct=$(rd capacity)
    # Rough Li-ion resting curve, only used to flag gross disagreement.
    approx=$(awk -v v="$v" 'BEGIN{
        split("3400000 3600000 3700000 3800000 3900000 4000000 4100000 4200000", bp, " ");
        split("0 15 35 55 70 85 95 100", sc, " ");
        if (v<=bp[1]) {print 0; exit} if (v>=bp[8]) {print 100; exit}
        for(i=1;i<8;i++) if (v>=bp[i] && v<bp[i+1]) {
            printf "%d", sc[i] + (sc[i+1]-sc[i])*(v-bp[i])/(bp[i+1]-bp[i]); exit}}')
    inf "voltage implies roughly ${approx}%, gauge reports ${pct}%"
    if [[ -n $pct && -n $approx ]] && (( pct - approx > 20 || approx - pct > 20 )); then
        warn "these disagree by more than 20 points -- do not trust the percentage"
    fi
    [[ -f $CSV ]] && { say "Last run"; inf "$(wc -l < "$CSV") samples in $CSV"; [[ -f $META ]] && sed 's/^/      /' "$META"; }
}

do_run(){
    need_root run
    say "Battery calibration"
    inf "This measures real pack capacity by integrating current during a"
    inf "controlled discharge. It stops at $(uv2v $FLOOR_UV) V and never runs the pack flat."
    echo
    if modem_is_on; then
        warn "The LTE modem is powered. Its transmit bursts draw ~4.4 A peaks,"
        warn "which distort the measurement and risk an undervoltage cut."
        inf  "Strongly recommended:  sudo uconsole-modem-power disable"
        read -r -p '      Continue anyway? [y/N] ' a; [[ ${a,,} == y ]] || exit 1
    fi
    mkdir -p "$DIR"

    # --- phase 1: full charge ---
    say "Phase 1 of 3 - charge to full"
    if ! on_ac; then
        inf "Plug in the charger now."
        while ! on_ac; do sleep 5; done
    fi
    inf "Charging. This can take a couple of hours; leave it plugged in."
    inf "Waiting for the CV taper to finish, not for status=Full -- this driver"
    inf "never sets it (see fully_charged())."
    CHARGED_WHY=""
    # Require the condition to HOLD, not merely occur: charge current is noisy
    # near the end and a single low sample is not the taper finishing.
    _hold=0; _need=3
    # And bound the wait, so a pack that will never reach the ceiling reports
    # that rather than hanging silently the way the old loop did.
    _deadline=$(( $(date +%s) + 4*3600 ))
    while :; do
        if fully_charged; then
            _hold=$((_hold+1))
            (( _hold >= _need )) && break
        else
            _hold=0
        fi
        printf '\r      %s V   %s%%   %s mA   %s   [%d/%d]        ' \
            "$(uv2v "$(rd voltage_now)")" "$(rd capacity)" \
            "$(( $(rd current_now | tr -d -) / 1000 ))" "$(rd status)" "$_hold" "$_need"
        sleep 30
        on_ac || { echo; err "AC removed during charge -- aborting"; exit 1; }
        if (( $(date +%s) > _deadline )); then
            echo; err "still not charged after 4 hours -- aborting"
            inf "last seen: $(uv2v "$(rd voltage_now)") V, $(rd capacity)%, $(rd status)"
            inf "If the pack is clearly full, the taper threshold may need raising:"
            inf "  sudo TAPER_UA=300000 uconsole-battery-calibrate run"
            exit 1
        fi
    done
    echo; ok "charged -- ${CHARGED_WHY}"

    # --- phase 2: measured discharge ---
    say "Phase 2 of 3 - discharge and measure"
    inf "UNPLUG the charger now. Leave the machine on and idle."
    while on_ac; do sleep 5; done
    ok "on battery; sampling every ${SAMPLE_SEC}s until $(uv2v $FLOOR_UV) V"

    # This loop forks nothing per sample.
    #
    # At ten seconds a sample that did not matter. At one second it does: the
    # old body cost 18.9 ms, of which only 5.8 ms was the four sysfs reads and
    # the rest was nine forks. A fork here is not only time -- it is scheduler
    # wakeups and a few mA added to the very current being measured. So: reads
    # by redirection, time from EPOCHREALTIME, totals in integer arithmetic,
    # progress redrawn on a timer rather than every sample, and a sleep that
    # waits on a FIFO instead of exec'ing /bin/sleep.
    #
    # Integer units picked so nothing can overflow a signed 64-bit bash integer:
    # charge in uA*ms (2.3e9 per second here, 5e13 over a six-hour run) and
    # energy in mA*mV*ms = uW*ms (8.5e9 per second, 2e14 over six hours). The
    # mA/mV truncation costs under 0.05%, far inside the ADC's own error.
    local v i cap st tnow start_ms prev_ms next_ms rem dt a nsamp=0
    local chg=0 nrg=0 mah3 wh3 whs draw_ms=0 sync_ms=0 tick_fd= fifo="$DIR/.tick"

    # The sleep: `read` with a timeout, on a FIFO nobody ever writes to. One
    # fork here at setup instead of one per sample; /bin/sleep if that fails.
    rm -f "$fifo"
    if mkfifo -m 600 "$fifo" 2>/dev/null; then
        exec {tick_fd}<>"$fifo" || tick_fd=
        rm -f "$fifo"
    fi

    # Keep the previous run; never overwrite it. Opening the log below used to
    # truncate it, and a run that then died left the old run.meta describing a
    # log that no longer existed -- which is how the pack's only full-discharge
    # log was lost on the test unit. Moving run.meta aside as well means an
    # unfinished run leaves none, so 'report' refuses instead of mixing the two.
    local keep f
    keep="$DIR/archive/$(date +%Y%m%dT%H%M%S)"
    for f in "$CSV" "$META" "$DIR/table.tsv"; do
        [[ -e $f ]] || continue
        mkdir -p "$keep" && mv "$f" "$keep"/ \
            || { err "could not archive $f -- refusing to overwrite it"; exit 1; }
    done
    [[ -d $keep ]] && ok "previous run kept in $keep"

    # Hold the log open rather than reopening it 3600 times an hour.
    exec 3>"$CSV"
    # Fractional epoch seconds: at this rate whole seconds would quantise dt by
    # up to 100%. 'report' reads this column as a number, so it needs no change.
    printf 'epoch,voltage_uv,current_ua,capacity_pct,status\n' >&3

    now_ms start_ms; prev_ms=$start_ms; next_ms=$start_ms
    while :; do
        rdv v voltage_now; rdv i current_now; rdv cap capacity; rdv st status
        now_ms tnow
        printf '%d.%03d,%s,%s,%s,%s\n' $(( tnow/1000 )) $(( tnow%1000 )) \
            "$v" "$i" "$cap" "$st" >&3

        # Integrate, checking the reads rather than trusting sysfs: a torn read
        # would otherwise land in the arithmetic as a syntax error.
        if [[ $v =~ ^[0-9]+$ && $i =~ ^-?[0-9]+$ ]] && (( tnow > prev_ms )); then
            dt=$(( tnow - prev_ms )); a=$(( i < 0 ? -i : i ))
            chg=$(( chg + a * dt ))
            nrg=$(( nrg + (a/1000) * (v/1000) * dt ))
            nsamp=$(( nsamp + 1 ))
        fi
        prev_ms=$tnow

        if (( tnow - draw_ms >= 2000 )); then
            draw_ms=$tnow
            mah3=$(( chg / 3600000 ))        # uA*ms -> mAh x1000
            wh3=$(( nrg / 3600000000 ))      # uW*ms -> Wh  x1000
            printf '\r      %d.%03d V   gauge %s%%   measured %d mAh / %d.%02d Wh   %dm elapsed     ' \
                $(( v/1000000 )) $(( v%1000000/1000 )) "$cap" \
                $(( mah3/1000 )) $(( wh3/1000 )) $(( wh3%1000/10 )) \
                $(( (tnow-start_ms)/60000 ))
        fi

        # A run is hours long; do not risk all of it to a wedge. One fork a
        # minute, against 3600 samples an hour.
        if (( tnow - sync_ms >= 60000 )); then
            sync_ms=$tnow; sync -d "$CSV" 2>/dev/null || sync 2>/dev/null || :
        fi

        on_ac && { echo; warn "AC reconnected -- discharge measurement ended early"; break; }
        [[ $v =~ ^[0-9]+$ ]] && (( v <= FLOOR_UV )) && { echo; ok "reached the $(uv2v $FLOOR_UV) V floor"; break; }

        # Sleep to the next deadline, so the interval does not drift by however
        # long the body took. If a sample ran long, skip ahead rather than spin.
        next_ms=$(( next_ms + SAMPLE_MS ))
        (( next_ms <= tnow )) && next_ms=$(( tnow + SAMPLE_MS ))
        rem=$(( next_ms - tnow ))
        if [[ -n $tick_fd ]]; then
            printf -v rem '%d.%03d' $(( rem/1000 )) $(( rem%1000 ))
            read -t "$rem" -u "$tick_fd" _ 2>/dev/null || :
        else
            printf -v rem '%d.%03d' $(( rem/1000 )) $(( rem%1000 ))
            sleep "$rem"
        fi
    done
    exec 3>&-
    [[ -n $tick_fd ]] && exec {tick_fd}>&-

    mah3=$(( chg / 3600000 )); wh3=$(( nrg / 3600000000 ))
    printf -v whs '%d.%02d' $(( wh3/1000 )) $(( wh3%1000/10 ))
    {
        echo "measured_mah=$(( mah3 / 1000 ))"
        echo "measured_wh=$whs"
        echo "floor_uv=$FLOOR_UV"
        echo "gauge_pct_at_floor=$cap"
        echo "sample_ms=$SAMPLE_MS"
        echo "samples=$nsamp"
        echo "date=$(date -Iseconds)"
    } > "$META"

    # --- phase 3: recharge ---
    say "Phase 3 of 3 - recharge"
    inf "Plug the charger back in; the pack should not be left near the floor."
    do_report
}

# Internal resistance, measured from the load steps already in the log.
#
# V = OCV - I*R, so between two consecutive samples R = -dV/dI. One sample
# interval of discharge moves the OCV by well under a millivolt at these
# currents, so a step in the load dominates that difference. The 0.4 A gate
# keeps only real steps: 0.4 A across this pack swings 27 mV, far above the
# ADC's noise. Median, not mean: a step that happens to coincide with something
# else is an outlier, and at one sample a second there are hundreds to pick from.
#
# Without this every voltage in the log is the loaded voltage, which is why a
# run that ends under load stops early: at 2.3 A this pack reads 0.16 V low.
pack_resistance(){
    [[ -f $CSV ]] || { echo 0; return; }
    awk -F, 'NR>2 && p2 != "" {
               di = ($3<0?-$3:$3)/1e6 - (p3<0?-p3:p3)/1e6
               dv = $2/1e6 - p2/1e6
               if (di > 0.4 || di < -0.4) { r = -dv/di; if (r > 0.005 && r < 0.5) print r }
             }
             { p2=$2; p3=$3 }' "$CSV" \
    | sort -n \
    | awk '{ v[NR]=$0 }
           END { if (!NR) { print 0; exit }
                 printf "%.4f\n", (NR%2 ? v[(NR+1)/2] : (v[NR/2]+v[NR/2+1])/2) }'
}

do_report(){
    [[ -f $META ]] || { err "no completed run -- run 'sudo uconsole-battery-calibrate run' first"; exit 1; }
    say "Calibration result"
    sed 's/^/      /' "$META"
    [[ -f $CSV ]] || { inf "no sample log at $CSV -- nothing else to derive"; return 0; }

    local R; R=$(pack_resistance)
    inf ""
    inf "Measured between 'Full' and $(uv2v $FLOOR_UV) V, at whatever load the machine"
    inf "was under. Everything below corrects for that load."
    local design; design=$(rd charge_full_design)
    [[ -n $design && $design != 0 ]] && inf "driver charge_full_design: $design uAh (from the device tree)"

    # table.tsv is only writable by root, but 'report' is worth running without
    # sudo -- and awk treats a failed redirect as FATAL, which took the printed
    # table down with the file. Send it to /dev/null instead, and say so.
    local table="$DIR/table.tsv" tnote=""
    if [[ ! -w $DIR ]]; then
        table=/dev/null
        tnote="not saved -- $DIR needs root; re-run with sudo to save it"
    fi

    say "Pack, corrected for its own resistance"
    awk -F, -v R="$R" -v table="$table" '
        NR>1 && $2 != "" { n++; t[n]=$1; v[n]=$2/1e6; i[n]=($3<0?-$3:$3)/1e6; g[n]=$4 }
        END {
            if (n < 10) { print "      too few samples to derive anything"; exit }
            # Charge and energy actually delivered, by trapezoid.
            used[1] = 0; usedwh[1] = 0
            for (k = 2; k <= n; k++) {
                dt = t[k] - t[k-1]; if (dt < 0) dt = 0; if (dt > 60) dt = 60
                mah += (i[k]+i[k-1])/2 * 1000 * dt / 3600
                wh  += (i[k]+i[k-1])/2 * (v[k]+v[k-1])/2 * dt / 3600
                used[k] = mah; usedwh[k] = wh
            }
            for (k = 1; k <= n; k++) ocv[k] = v[k] + i[k]*R
            # What is left below the stop, from the curve just measured: how many
            # mAh the last 600 mAh of the run took per volt of OCV.
            s = 1; for (k = 1; k <= n; k++) if (mah - used[k] < 600) { s = k; break }
            dq = used[n] - used[s]; dv = ocv[s] - ocv[n]
            if (dv > 0.01) slope = dq/dv
            tail35 = slope * (ocv[n] - 3.50); if (tail35 < 0) tail35 = 0
            tail34 = slope * (ocv[n] - 3.40); if (tail34 < 0) tail34 = 0
            qfull = mah + tail35; whfull = wh + tail35/1000*3.55
            printf "      %-34s %s\n", "resistance (from load steps)", (R > 0 ? sprintf("%.0f mOhm", R*1000) : "not measurable")
            printf "      %-34s %.0f mAh / %.2f Wh\n", "delivered during the run", mah, wh
            printf "      %-34s %.3f V at %.2f A\n", "voltage at the stop, corrected", ocv[n], i[n]
            printf "      %-34s %.0f mAh\n", "left below the stop (to 3.50 V)", tail35
            printf "      %-34s %.0f mAh / %.1f Wh\n", "PACK to 3.50 V resting", qfull, whfull
            printf "      %-34s %.0f mAh\n", "PACK to 3.40 V resting (the guard)", mah + tail34
            print ""
            print "      resting V   load    used     left    left    true    gauge   gauge"
            print "                    A     mAh      mAh      Wh     SoC      says   error"
            printf "" > table
            # Stamp the resistance into the datasheet. Anything correcting a
            # loaded voltage to an OCV needs it, and the alternative is
            # re-deriving it from the whole sample log on every lookup.
            printf "# pack_resistance_ohm %.4f\n", R > table
            print "# resting_v\tload_a\tused_mah\tleft_mah\tleft_wh\ttrue_soc\tgauge" > table
            # Index the bins by their PRINTED form. Indexing by the number
            # instead stores "4.2" (awk stringifies with CONVFMT) while the
            # loop below looks up "4.20", so every bin ending in a zero
            # silently vanished from the table.
            for (k = 1; k <= n; k++) {
                key = sprintf("%.2f", int(ocv[k]*20+0.5)/20)
                c[key]++; cu[key]+=used[k]; cw[key]+=usedwh[k]; ci[key]+=i[k]; cg[key]+=g[k]
            }
            m = 0; for (key in c) if (key+0 > m) m = key+0
            for (b = m; b >= 3.3; b -= 0.05) {
                key = sprintf("%.2f", b); if (!(key in c)) continue
                u = cu[key]/c[key]; soc = 100*(qfull-u)/qfull
                printf "      %7.2f  %6.2f %7.0f  %7.0f  %6.2f %6.0f%% %8.0f%% %+6.0f\n", \
                    key, ci[key]/c[key], u, qfull-u, whfull-cw[key]/c[key], soc, cg[key]/c[key], cg[key]/c[key]-soc
                printf "%.2f\t%.2f\t%.0f\t%.0f\t%.2f\t%.0f\t%.0f\n", \
                    key, ci[key]/c[key], u, qfull-u, whfull-cw[key]/c[key], soc, cg[key]/c[key] > table
            }
        }' "$CSV"

    inf ""
    inf "\"resting V\" is what the pack would read with no load on it, so compare"
    inf "it against a voltage measured while the machine is idle, not busy."
    inf "Saved for other tools: ${tnote:-$DIR/table.tsv}"
    inf "Full sample log: $CSV"
    inf "The gauge column is the AXP's own percentage. Where it disagrees with"
    inf "\"true SoC\", the gauge is the one that is wrong -- it is uncalibrated,"
    inf "and uconsole-battery-guard deliberately uses volts instead."
}

# Voltage -> charge, from the calibrated table. The datasheet lookup.
#
# 'run' measures the pack once and 'report' writes table.tsv; anything that needs
# to turn a voltage into energy reads it from here rather than assuming a slope.
# The slope is emphatically not constant. Measured on this pack: 58.6 Wh/V
# between 4.00 and 3.95 V, ~37 Wh/V from 3.95 down to 3.80, ~30 Wh/V by 3.75, and
# near vertical above 4.15 where 50 mV is worth 9 mAh. Pricing a voltage drop
# with one global scale is therefore wrong by up to 1.6x depending only on where
# the measurement happened to sit.
#
# Pass a current too and the loaded voltage is corrected to an open-circuit
# voltage first (OCV = V - I*R, with I signed as sysfs reports it: negative
# discharging, positive charging). That matters here: at 0.9 A this pack reads
# 61 mV low, which is more than one whole bin of the table.
#
# The sign is not decoration. An earlier version used |I| and so added the
# correction while CHARGING too, where the terminal voltage is already ABOVE the
# OCV -- asked about a pack sitting at 4.030 V taking 2.081 A it answered
# 4.172 V and "100%" for a pack actually near 3.888 V and 51%.
do_soc(){
    local uv=${1:-} ua=${2:-0}
    [[ -n $uv ]] || { err "usage: uconsole-battery-calibrate soc <voltage_uv> [current_ua]"; exit 2; }
    local T="$DIR/table.tsv"
    [[ -r $T ]] || {
        err "no calibrated table at $T"
        inf "measure the pack first: sudo uconsole-battery-calibrate run"
        exit 1
    }
    awk -v uv="$uv" -v ua="$ua" -v fallback="${PACK_R_OHM:-0.068}" '
        /^#[ \t]*pack_resistance_ohm/ { R = $3 + 0; next }
        /^#/ { next }
        NF >= 6 { n++; V[n] = $1 + 0; Q[n] = $4 + 0; W[n] = $5 + 0; S[n] = $6 + 0 }
        END {
            if (n < 2) { print "error=table_too_short"; exit 1 }
            if (R <= 0) R = fallback + 0
            # Signed: discharging (ua < 0) raises the OCV above the terminal
            # voltage, charging lowers it.
            ocv = uv/1e6 - (ua/1e6) * R
            # Rows run high voltage -> low; find the bracketing pair.
            k = 0
            for (j = 1; j < n; j++) if (ocv <= V[j] && ocv >= V[j+1]) { k = j; break }
            clamp = "no"
            if (k == 0) {
                if (ocv > V[1]) { k = 1;   clamp = "above_table" }
                else            { k = n-1; clamp = "below_table" }
            }
            # Outside the table this extrapolates on the end bin s slope, which
            # is why clamped= is reported rather than silently clipping.
            dv    = V[k] - V[k+1]
            f     = dv > 0 ? (V[k] - ocv) / dv : 0
            slope = dv > 0 ? (W[k] - W[k+1]) / dv : 0
            printf "ocv_v=%.4f\n",         ocv
            printf "left_mah=%.1f\n",      Q[k] + f * (Q[k+1] - Q[k])
            printf "left_wh=%.4f\n",       W[k] + f * (W[k+1] - W[k])
            printf "true_soc=%.1f\n",      S[k] + f * (S[k+1] - S[k])
            printf "slope_wh_per_v=%.2f\n", slope
            printf "resistance_ohm=%.4f\n", R
            printf "clamped=%s\n",         clamp
        }' "$T"
}

do_apply(){
    need_root apply
    say "Applying calibration where the driver allows it"
    local wrote=0
    if [[ -w $B/calibrate ]]; then
        if echo 1 > "$B/calibrate" 2>/dev/null; then ok "triggered PMIC gauge calibration (calibrate=1)"; wrote=1
        else warn "calibrate is writable but the write was rejected"; fi
    else
        warn "calibrate is not writable on this kernel -- nothing to trigger"
    fi
    if [[ -f $META && -w $B/charge_full_design ]]; then
        local mah; mah=$(awk -F= '/measured_mah/{print $2}' "$META")
        if [[ -n $mah && $mah -gt 0 ]]; then
            if echo $(( mah * 1000 )) > "$B/charge_full_design" 2>/dev/null; then
                ok "wrote charge_full_design=$(( mah * 1000 )) uAh from the measured run"; wrote=1
            else warn "could not write charge_full_design"; fi
        fi
    fi
    (( wrote )) || {
        inf "This kernel exposes no writable calibration attributes."
        inf "The measurement in 'report' is still the useful output: use it to"
        inf "judge real runtime, and rely on voltage rather than percentage."
    }
}

case "${1-status}" in
    status)  show_status ;;
    run)     do_run ;;
    report)  do_report ;;
    soc)     shift; do_soc "$@" ;;
    apply)   do_apply ;;
    abort)   need_root abort; rm -f "$CSV" "$META"; ok "cleared saved calibration data" ;;
    *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
