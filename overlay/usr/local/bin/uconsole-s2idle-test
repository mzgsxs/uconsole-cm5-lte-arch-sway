#!/usr/bin/env bash
# uconsole-s2idle-test {check|bisect|run} -- is s2idle usable, and is it worth it?
#
#   check    report readiness and change nothing
#   bisect   pm_test ladder: exercise the failing phase WITHOUT calling firmware
#   run      measure blanked-awake vs actually-suspended drain, and compare
#   report   print the last run's results again, e.g. after a reboot
#   pstore   read the kernel log that survived the last hang (needs ramoops)
#   wake-check  can anything actually wake this machine? never suspends
#
#   unload-wifi / restore-wifi   take brcmfmac out of the suspend path, and
#                                put it back. Always pair them.
#
# READ THIS BEFORE USING `run`
#
# On this hardware suspend has hard-hung the machine five times out of five,
# needing four battery pulls, and left the FAT boot partition dirty twice. The
# sleep targets are masked in this image for that reason; this script writes
# /sys/power/state directly, which is a deliberate experiment, not an accident.
#
# brcmfmac has to be out of the kernel first. Its ->suspend() wedges the SDIO
# backplane with -110 timeouts, and `rfkill block` leaves that callback in
# place; unloading the module removes it. If you only use the LTE modem for
# connectivity, losing Wi-Fi across a suspend costs you nothing.
#
# WHY EVERY EARLIER `run` ENDED IN A WATCHDOG RESET  (read from the source)
#
# On the stock kernel nothing can end an s2idle on this board, so a machine that
# suspended perfectly was indistinguishable from one that hung:
#
#   - rtc-rpi has no interrupt. It declares RTC_FEATURE_ALARM_WAKEUP_ONLY: its
#     alarm powers the board up from halt, and `rtcwake -m mem` arms nothing
#     Linux will ever hear.
#   - The power key is on the AXP223, whose interrupt is RP1 GPIO 2. pinctrl-rp1
#     has no irq_set_wake, so enable_irq_wake() fails -- that is the
#     "Unbalanced IRQ n wake disable" seen on resume. And pcie-brcmstb asserts
#     PERST# on RP1's link in suspend_noirq, resetting RP1 outright.
#   - bcm2835_wdt has no PM ops. Under RuntimeWatchdogSec=15 the hardware
#     watchdog resets the board ~15 s after systemd's last ping, however well
#     the suspend went.
#
# --with-fixes turns on the kernel changes in build/patches 0003-0005 for the
# duration of the command. Each defaults to stock behaviour:
#
#   pinctrl_rp1.gpio_wake=Y              an RP1 GPIO (the power key) may wake it
#   pcie_brcmstb.keep_link_in_suspend=Y  RP1's link, and RP1, are left alone
#   rtc_rpi.emulate_alarm_irq=Y          alarms are delivered from an hrtimer,
#                                        so rtcwake can end the sleep
#
# `run` and `bisect` also raise systemd's runtime watchdog for their duration.
# The kernel's watchdogd then feeds the hardware while userspace is frozen:
# timers keep running through s2idle here, because with no cpuidle driver the
# s2idle loop is ordinary idle and the tick is never frozen. A hang that stops
# the kernel's timers is still reset within ~16 s; anything else is reset at the
# raised deadline, so a sleep that nothing wakes ends by itself.
#
# RUNNING IT WITHOUT A SCREEN
#
# Anything that suspends takes Wi-Fi with it. Do not run it inside an SSH
# session: start it as a transient unit, which outlives the session, and read the
# results once the network is back.
#
#   sudo systemd-run --unit=uconsole-s2idle --collect \
#        /usr/local/bin/uconsole-s2idle-test bisect --cycle-wifi --with-fixes
#   journalctl -b -u uconsole-s2idle         # afterwards; -b -1 after a reset
#
# WHAT TO EXPECT EVEN IF IT WORKS
#
# Pi 5 has no cpuidle driver at all (`cpuidle/current_driver` reads `none`), so
# there are no C-states for s2idle to enter -- it mostly just stops the
# scheduler. The only published Raspberry Pi s2idle figure is 0.34 W, measured
# on a Pi 1. Set expectations accordingly: this is a measurement to settle the
# question, not a fix that will transform battery life.
#
# `deep` is never used and never will be: it is a PSCI firmware stub with no DDR
# self-refresh behind it. This script forces s2idle and verifies it took, because
# /sys/power/mem_sleep resets to `deep` on EVERY boot.
set -uo pipefail

B=/sys/class/power_supply/axp20x-battery
AC=/sys/class/power_supply/axp22x-ac/online
BREADCRUMB=/var/lib/uconsole/s2idle-attempt
# Results are appended and SYNCED as each number is known, never held in memory
# until the end. The first run of this script lost everything it measured: the
# machine wedged while printing the summary, so the report existed only on a
# stdout nobody could read any more. Anything learned before the hang must be on
# disk before the hang.
RESULTS=/var/lib/uconsole/s2idle-results
# The kernel log of each attempt, cut at a marker and synced the same way.
LOGDIR=/var/lib/uconsole/s2idle-dmesg
MINUTES=20
ALLOW_WIFI=0
ALLOW_AC=0
CYCLE_WIFI=0
WITH_FIXES=0
MODEM_LOW=0
CONFIRM=0
PRINT_TIMES=0
WAKE_BUTTON=0
PANEL_RESTORE=1

# The three switches patches 0003-0005 add; all default to stock behaviour.
KP_WAKE=/sys/module/pinctrl_rp1/parameters/gpio_wake
KP_LINK=/sys/module/pcie_brcmstb/parameters/keep_link_in_suspend
KP_RTC=/sys/module/rtc_rpi/parameters/emulate_alarm_irq
PM_DELAY=/sys/module/suspend/parameters/pm_test_delay

die()  { echo "uconsole-s2idle-test: $*" >&2; exit 1; }
say()  { printf '  %s\n' "$*"; }
ok()   { printf '  ok    %s\n' "$*"; }
no()   { printf '  NO    %s\n' "$*"; }

need_root() { [[ $EUID -eq 0 ]] || die "must run as root"; }

gauge_mode() {
    # Prefer a coulomb counter: over a 20-minute window a voltage delta is mostly
    # noise, while charge/energy integrate the actual draw.
    [[ -r $B/energy_now ]] && { echo energy; return; }
    [[ -r $B/charge_now ]] && { echo charge; return; }
    echo voltage
}

read_gauge() {   # prints a single integer in the unit implied by gauge_mode
    case "$(gauge_mode)" in
        energy)  cat "$B/energy_now" ;;      # uWh
        charge)  cat "$B/charge_now" ;;      # uAh
        voltage) cat "$B/voltage_now" ;;     # uV
    esac
}

### kernel switches -----------------------------------------------------------
declare -A KP_SAVED=()

fixes_state() {
    local p out=""
    for p in "$KP_WAKE" "$KP_LINK" "$KP_RTC"; do
        out+="$(basename "$p")=$(cat "$p" 2>/dev/null || echo absent) "
    done
    echo "${out% }"
}

fixes_apply() {   # Y|N -- set all three; refuse Y on a kernel without them
    local p
    for p in "$KP_WAKE" "$KP_LINK" "$KP_RTC"; do
        if [[ -w $p ]]; then
            [[ -n ${KP_SAVED[$p]:-} ]] || KP_SAVED[$p]=$(cat "$p")
            echo "$1" > "$p" || die "could not write $p"
        elif [[ $1 == Y ]]; then
            die "$(basename "$p") is missing -- this kernel does not carry patches 0003-0005"
        fi
    done
}

fixes_restore() {
    local p
    for p in "${!KP_SAVED[@]}"; do echo "${KP_SAVED[$p]}" > "$p" 2>/dev/null; done
    KP_SAVED=()
}

### watchdog ------------------------------------------------------------------
# systemd's runtime watchdog is a writable property of the manager, so it can be
# raised for exactly as long as a sleep lasts and put back afterwards. The header
# explains why a sleep cannot happen at all without this.
WD_SAVED=""
wd_get() {
    busctl get-property org.freedesktop.systemd1 /org/freedesktop/systemd1 \
        org.freedesktop.systemd1.Manager RuntimeWatchdogUSec 2>/dev/null | awk '{print $2}'
}
wd_set() {
    busctl set-property org.freedesktop.systemd1 /org/freedesktop/systemd1 \
        org.freedesktop.systemd1.Manager RuntimeWatchdogUSec t "$1" 2>/dev/null
}
wd_raise() {   # seconds
    [[ -n $WD_SAVED ]] || WD_SAVED=$(wd_get)
    [[ -n $WD_SAVED ]] || die "cannot read systemd's RuntimeWatchdogUSec"
    wd_set $(( $1 * 1000000 )) || die "could not raise the watchdog; refusing to sleep under a 15 s one"
    rec "watchdog_raised_s=$1 was_us=$WD_SAVED"
}
wd_restore() {
    [[ -n $WD_SAVED ]] || return 0
    wd_set "$WD_SAVED" && rec "watchdog_restored_us=$WD_SAVED"
    WD_SAVED=""
}

### kernel log -----------------------------------------------------------------
# console=tty1 puts printk on the VT sway owns, so nobody sees it live. Mark the
# log before each attempt and keep everything after the mark.
mark() { echo "uconsole-s2idle-test: begin $1" > /dev/kmsg 2>/dev/null; }
keep_log() {   # label -- save the log since `mark label`, print the lines that matter
    local f="$LOGDIR/$1.txt"
    mkdir -p "$LOGDIR"
    dmesg 2>/dev/null | awk -v m="uconsole-s2idle-test: begin $1" 'index($0, m) {p=1} p' > "$f"
    sync
    grep -E 'failed to suspend|returns -[0-9]|Unbalanced IRQ|link up|keeping the link|flip_done|commit wait|Triggering wakeup|suspend entry|suspend exit|suspend-to-idle' "$f" \
        | sed 's/^/        /' | tail -25 || true
    say "wakeup irq: $(cat /sys/power/pm_wakeup_irq 2>/dev/null || echo none)   full log: $f"
}

PM_DEBUG_SAVED=""
pm_debug_on() {   # the PM core names the wakeup IRQ and each suspend-to-idle step
    [[ -w /sys/power/pm_debug_messages ]] || return 0
    PM_DEBUG_SAVED=$(cat /sys/power/pm_debug_messages)
    echo 1 > /sys/power/pm_debug_messages
}

### readiness ---------------------------------------------------------------
do_check() {
    echo "== power source"
    if [[ $(cat "$AC" 2>/dev/null || echo 0) == 1 ]]; then
        no "on AC -- drain cannot be measured; unplug before running"
    else
        ok "on battery"
    fi

    echo "== gauge"
    local m; m=$(gauge_mode)
    case "$m" in
        energy|charge) ok "coulomb counter available ($m); drain will be accurate" ;;
        voltage)       no "no charge/energy counter -- falling back to voltage delta," ;;
    esac
    [[ $m == voltage ]] && say "which is noisy. Use a longer --minutes to compensate."
    say "voltage now: $(awk "BEGIN{printf \"%.3f\", $(cat $B/voltage_now 2>/dev/null || echo 0)/1000000}") V"

    echo "== sleep states"
    say "state:     $(cat /sys/power/state 2>/dev/null)"
    say "mem_sleep: $(cat /sys/power/mem_sleep 2>/dev/null)   <- resets to [deep] every boot"
    [[ -r /sys/power/pm_test ]] && ok "pm_test available -- 'bisect' can test without calling firmware" \
                                || no "pm_test unavailable (CONFIG_PM_DEBUG off); 'bisect' cannot run"

    echo "== the thing being tested"
    if [[ $(lsmod 2>/dev/null | grep -c '^brcmfmac') -gt 0 ]]; then
        no "brcmfmac is LOADED -- its broken ->suspend() will run and is expected to hang"
        say "unload with: sudo uconsole-s2idle-test unload-wifi  (or pass --cycle-wifi)"
    else
        ok "brcmfmac not loaded -- the suspect callback cannot run"
    fi

    echo "== modem"
    if [[ $(lsmod 2>/dev/null | grep -c 'qmi_wwan\|option\|cdc_') -gt 0 ]]; then
        say "USB modem drivers loaded; they have suspend callbacks too and are the"
        say "next most likely culprit if a wifi-free suspend still hangs."
    fi

    echo "== kernel switches (patches 0003-0005; each defaults to stock)"
    local p
    for p in "$KP_WAKE" "$KP_LINK" "$KP_RTC"; do
        printf '   %-24s %s\n' "$(basename "$p")" "$(cat "$p" 2>/dev/null || echo 'absent -- kernel lacks the patch')"
    done

    echo "== what could end a sleep, as the switches stand"
    if [[ $(cat "$KP_RTC" 2>/dev/null) == Y ]]; then
        ok "an RTC alarm (rtcwake), delivered by emulate_alarm_irq"
    else
        no "an RTC alarm: rtc-rpi raises no interrupt unless emulate_alarm_irq is on"
    fi
    if [[ $(cat "$KP_WAKE" 2>/dev/null) == Y && $(cat "$KP_LINK" 2>/dev/null) == Y ]]; then
        ok "the power key, through RP1 GPIO 2"
    else
        no "the power key: needs gpio_wake and keep_link_in_suspend"
    fi
    say "(run --with-fixes turns all three on for its own duration)"

    echo "== watchdog"
    say "hardware: $(cat /sys/class/watchdog/watchdog0/state 2>/dev/null || echo '?'), timeout $(cat /sys/class/watchdog/watchdog0/timeout 2>/dev/null || echo '?') s"
    say "systemd RuntimeWatchdogUSec: $(wd_get || echo '?')"
    say "run and bisect raise it while they work; a sleep under 15 s of it ends in a reset"

    echo "== previous attempts"
    if [[ -f $BREADCRUMB ]]; then
        no "an earlier attempt did not complete:"
        sed 's/^/        /' "$BREADCRUMB"
        say "if that boot ended in a hang, check /boot before testing again:"
        say "  sudo umount /boot && sudo fsck.vfat -a /dev/mmcblk0p1 && sudo mount /boot"
    else
        ok "no unfinished attempt recorded"
    fi
}

### wifi --------------------------------------------------------------------
do_unload_wifi() {
    need_root
    # NO `nmcli radio wifi off` here.
    #
    # It used to be the first line, and it is the reason Wi-Fi stayed dead after
    # a reboot. NetworkManager persists that flag as WirelessEnabled=false in
    # /var/lib/NetworkManager/NetworkManager.state, which is its own state and has
    # nothing to do with rfkill -- so masking systemd-rfkill (which this image
    # does) does not stop it surviving. It was also pointless: unloading the
    # module removes the interface outright, and NetworkManager does not load
    # drivers, so there is nothing for it to re-probe.
    #
    # The stamp below is the belt to that braces: uconsole-radio-restore.service
    # reads it at boot and unblocks anything still blocked, so a session that
    # never gets to reload the module still comes back with a radio.
    mkdir -p /var/lib/uconsole
    touch /var/lib/uconsole/radios-off-by-lowpower

    # Order matters: the bus-specific shims hold references on the core module.
    modprobe -r brcmfmac_wcc brcmfmac_cyw brcmfmac_bca 2>/dev/null
    modprobe -r brcmfmac 2>/dev/null
    modprobe -r brcmutil 2>/dev/null
    if [[ $(lsmod | grep -c '^brcmfmac') -eq 0 ]]; then
        echo "brcmfmac unloaded."
        echo "Restore it with:  sudo uconsole-s2idle-test restore-wifi"
        echo "NOTE: after a failed suspend the chip may need a full REBOOT, not a"
        echo "      modprobe -- reprobing all three SDIO functions fails with -110."
    else
        die "brcmfmac would not unload; something still holds it (lsmod | grep brcmfmac)"
    fi
}

do_restore_wifi() {
    need_root
    modprobe brcmfmac 2>/dev/null
    # Unconditional, and both mechanisms: rfkill and NetworkManager's own flag are
    # independent, and either one alone leaves the radio apparently dead.
    rfkill unblock wifi 2>/dev/null
    nmcli radio wifi on >/dev/null 2>&1
    rm -f /var/lib/uconsole/radios-off-by-lowpower
    sleep 2
    if [[ -n $(ip -br link show 2>/dev/null | awk '/^wl/{print $1}') ]]; then
        echo "wifi restored: $(ip -br link show | awk '/^wl/{print $1, $2}')"
    else
        echo "no wireless interface yet."
        echo "If the chip was wedged by a failed suspend, only a reboot recovers it:"
        echo "reprobing all three SDIO functions fails with -110 until the mmc host"
        echo "is reinitialised from cold."
    fi
}

# --cycle-wifi: take brcmfmac out for the attempt and put it back at exit, so a
# test started over SSH brings its own network back.
WIFI_CYCLED=0
wifi_out() {
    (( CYCLE_WIFI )) || return 0
    [[ $(lsmod | grep -c '^brcmfmac') -gt 0 ]] || return 0
    do_unload_wifi >/dev/null
    WIFI_CYCLED=1
    rec "wifi=unloaded"
}
wifi_back() {
    (( WIFI_CYCLED )) || return 0
    WIFI_CYCLED=0
    do_restore_wifi
    rec "wifi=restored $(ip -br link show 2>/dev/null | awk '/^wl/{print $1"/"$2}')"
}

### modem ---------------------------------------------------------------------
# ModemManager's low -> on leaves the modem `disabled`, and a bearer then times
# out; uconsole-modem-wake does the whole sequence. Started the way
# uconsole-lowpower starts it, as a transient unit, so nothing here waits on it.
modem_back() {
    (( MODEM_LOW )) || return 0
    local args=() wm
    wm=$(cat /var/lib/uconsole/wan-mode 2>/dev/null)
    [[ -n $wm ]] && args+=(--wan-mode "$wm")
    systemctl stop uconsole-modem-wake.service >/dev/null 2>&1
    systemctl reset-failed uconsole-modem-wake.service >/dev/null 2>&1
    systemd-run --unit=uconsole-modem-wake --collect \
        /usr/local/bin/uconsole-modem-wake "${args[@]}" >/dev/null 2>&1 \
        && rec "modem=waking" || rec "modem=wake-failed-to-start"
}

### cleanup -------------------------------------------------------------------
# Whatever happens, leave the machine as it was found: no pm_test level armed,
# the watchdog back at its configured value, the kernel switches back, Wi-Fi
# back.
PM_DELAY_SAVED=""
cleanup() {
    [[ -w /sys/power/pm_test ]] && echo none > /sys/power/pm_test 2>/dev/null
    [[ -n $PM_DELAY_SAVED ]] && echo "$PM_DELAY_SAVED" > "$PM_DELAY" 2>/dev/null
    [[ -n $PM_DEBUG_SAVED ]] && echo "$PM_DEBUG_SAVED" > /sys/power/pm_debug_messages 2>/dev/null
    wd_restore
    fixes_restore
    wifi_back
}

### force s2idle ------------------------------------------------------------
force_s2idle() {
    [[ -w /sys/power/mem_sleep ]] || die "cannot write /sys/power/mem_sleep"
    echo s2idle > /sys/power/mem_sleep 2>/dev/null
    # Verify. mem_sleep resets to `deep` on every boot, and `deep` is the PSCI
    # stub -- taking it by accident is exactly how this hardware got wedged.
    local sel
    sel=$(sed 's/.*\[\(.*\)\].*/\1/' /sys/power/mem_sleep 2>/dev/null)
    [[ $sel == s2idle ]] || die "mem_sleep is '$sel', refusing to continue (would call the firmware stub)"
    echo "$sel"
}

### breadcrumbs -------------------------------------------------------------
# Written and SYNCED before every suspend, so that if the machine hangs and you
# have to pull the battery, the next boot can still say how far it got. Nothing
# in the journal survives that; this does.
rec() {   # append one key=value to the results file and force it to disk
    mkdir -p /var/lib/uconsole
    printf '%s\t%s\n' "$(date -Is)" "$*" >> "$RESULTS"
    sync
}

crumb() {
    mkdir -p /var/lib/uconsole
    { echo "when:      $(date -Is)"; echo "phase:     $1"
      echo "mem_sleep: $(cat /sys/power/mem_sleep 2>/dev/null)"
      echo "brcmfmac:  $(lsmod | grep -c '^brcmfmac') module(s) loaded"
      echo "switches:  $(fixes_state)"
      echo "gauge:     $(read_gauge) ($(gauge_mode))"; } > "$BREADCRUMB"
    sync
}

### bisect ------------------------------------------------------------------
do_bisect() {
    need_root
    [[ -w /sys/power/pm_test ]] || die "no /sys/power/pm_test (CONFIG_PM_DEBUG is off)"
    cat <<'EOT'
pm_test stops a suspend at a chosen phase and returns without completing it.

The levels are CUMULATIVE, and the order the kernel prints them in is not the
severity order. What actually matters here is where each one stops:

  freezer     freeze tasks, return
  devices     + dpm_suspend_start()  -- prepare + suspend callbacks
              *** returns BEFORE suspend_enter(), so it never runs
                  dpm_suspend_late() or dpm_suspend_noirq() ***
  platform    + suspend_late + suspend_NOIRQ + platform prepare, then return
              *** the last level that is still a TEST under s2idle ***
  processors  } for s2idle these do NOT stop early -- suspend_test() matches on
  core        } equality, so the s2idle loop runs and the machine really sleeps

`devices` passing therefore says nothing about a bug in a ->suspend_noirq()
callback -- which is where the brcmstb GPIO abort lives. `platform` is the first
level that exercises it, and under s2idle it is also the LAST level that is still
a test rather than the real thing. This ladder stops there deliberately.

EOT
    if [[ $(lsmod | grep -c '^brcmfmac') -gt 0 ]] && (( ! CYCLE_WIFI )); then
        die "brcmfmac is loaded, and its suspend callback wedges the chip until a reboot. Pass --cycle-wifi, or unload-wifi first."
    fi
    force_s2idle >/dev/null
    (( WITH_FIXES )) && fixes_apply Y
    rec "bisect_start $(fixes_state)"
    say "kernel switches: $(fixes_state)"
    wifi_out
    pm_debug_on
    # Userspace is frozen from `freezer` on, so every second of a level is a
    # second nobody feeds the watchdog. Raise it for the ladder, and cut the
    # 5 s the kernel waits at each level to 1 s -- enough to prove it returns.
    PM_DELAY_SAVED=$(cat "$PM_DELAY" 2>/dev/null)
    echo 1 > "$PM_DELAY" 2>/dev/null
    wd_raise 120
    local worst=""
    # STOP AT platform. Going further is not a test -- it is a real suspend.
    #
    # suspend_test() is an EQUALITY check (pm_test_level == level), not a
    # threshold, and for s2idle suspend_enter() branches like this:
    #
    #     if (suspend_test(TEST_PLATFORM)) goto Platform_wake;
    #     if (state == PM_SUSPEND_TO_IDLE) { s2idle_loop(); goto Platform_wake; }
    #     error = suspend_disable_secondary_cpus();      <- never reached
    #     if (suspend_test(TEST_CPUS)) ...               <- never reached
    #
    # So selecting `processors` or `core` while mem_sleep is s2idle does NOT stop
    # anywhere: the TEST_PLATFORM equality fails, the s2idle branch is taken, and
    # the machine performs the full suspend this command exists to avoid. An
    # earlier version of this ladder walked all five levels and would have hung
    # the machine on level three while claiming to be testing safely.
    for level in freezer devices platform; do
        echo "-- pm_test=$level"
        crumb "bisect:$level"
        rec "bisect_attempt=$level"
        echo "$level" > /sys/power/pm_test 2>/dev/null || { no "cannot select $level"; continue; }
        mark "bisect-$level"
        if echo mem > /sys/power/state 2>/dev/null; then
            ok "$level completed and returned control"
            rec "bisect_ok=$level"
            worst="$level"
        else
            no "$level returned an error -- something in this phase refused"
            rec "bisect_fail=$level"
            say "the failure is in the phase this level ADDS over the previous one"
            keep_log "bisect-$level"
            break
        fi
        # A display that lost its interrupt only shows it on the next commit,
        # which then waits out a 10 s flip_done timeout. Give it the chance.
        [[ $level == platform ]] && sleep 15
        keep_log "bisect-$level"
    done
    echo none > /sys/power/pm_test 2>/dev/null
    rm -f "$BREADCRUMB"
    echo
    [[ -n $worst ]] && echo "Deepest level that returned cleanly: $worst"
    echo "pm_test reset to none."
    echo "If the machine hangs at a level rather than returning an error, that level"
    echo "is where it dies -- read /sys/fs/pstore after the watchdog reboots you."
}

### run ---------------------------------------------------------------------
do_run() {
    need_root
    (( CONFIRM )) || die "refusing without --yes-i-may-lose-this-boot (read the header)"
    local on_ac=0
    [[ $(cat "$AC" 2>/dev/null || echo 0) == 1 ]] && on_ac=1
    if (( on_ac && ! ALLOW_AC )); then
        die "on AC -- unplug; charging current makes drain meaningless (--allow-ac for a survival-only run)"
    fi
    [[ -e /dev/rtc0 ]] || die "no /dev/rtc0"
    if [[ $(lsmod | grep -c '^brcmfmac') -gt 0 ]] && (( ! ALLOW_WIFI && ! CYCLE_WIFI )); then
        die "brcmfmac is loaded; that is the known hang. Pass --cycle-wifi, run 'unload-wifi' first, or --allow-wifi to insist."
    fi
    (( WITH_FIXES )) && fixes_apply Y
    # Refuse a sleep that nothing can end. It would not hang -- the raised
    # watchdog resets it at the deadline -- but it would teach nothing that is
    # not already known, at the price of an unclean reset.
    if (( WAKE_BUTTON )); then
        [[ $(cat "$KP_WAKE" 2>/dev/null) == Y && $(cat "$KP_LINK" 2>/dev/null) == Y ]] ||
            die "the power key cannot wake this kernel: it needs gpio_wake and keep_link_in_suspend (--with-fixes)"
    else
        [[ $(cat "$KP_RTC" 2>/dev/null) == Y ]] ||
            die "nothing would end the sleep: rtc-rpi raises no alarm interrupt. Pass --with-fixes, or --wake-button"
    fi

    local secs=$(( MINUTES * 60 )) mode; mode=$(gauge_mode)
    # The coulomb counter moves in coarse steps. Measured on this unit, a 60s
    # window left energy_now completely unchanged, so a short run cannot produce
    # a drain figure no matter how well the suspend goes. Say so up front rather
    # than letting someone read 0.000 W as a result.
    if (( MINUTES < 10 )) && [[ $mode != voltage ]] && (( ! on_ac )); then
        echo "NOTE: ${MINUTES} min is too short to measure drain with the ${mode} gauge --"
        echo "      a 60s window was observed not to tick at all. Use --minutes 20 for a"
        echo "      real figure. Short runs are still useful for testing SURVIVAL."
        echo
    fi
    # Cache the voltage NOW. Reading the PMIC over I2C after a failed suspend can
    # block, and the summary must never be the thing that hangs.
    local vnow; vnow=$(cat "$B/voltage_now" 2>/dev/null || echo 0)
    : > "$RESULTS"
    rec "start minutes=$MINUTES gauge=$mode voltage_uv=$vnow ac=$on_ac"
    rec "kernel_switches $(fixes_state)"
    wifi_out
    rec "brcmfmac_loaded=$(lsmod | grep -c '^brcmfmac')"
    pm_debug_on
    echo "Results are written to $RESULTS as they are taken, so a hang loses nothing."
    echo

    if (( on_ac )); then
        echo "On AC: a survival run only. No drain figures, and no awake phase."
    else
        echo "Two phases of ${MINUTES} min each, measured with the ${mode} gauge."
        # Phase 1: the machine as it already behaves -- blanked but awake. This is
        # the control, and the only figure s2idle has to beat.
        echo "== phase 1/2: blanked, awake (the current low-power blank)"
        /usr/local/bin/uconsole-lowpower down >/dev/null 2>&1
        local a1 a2
        a1=$(read_gauge); rec "awake_before=$a1"
        sleep "$secs"
        a2=$(read_gauge); rec "awake_after=$a2"
        /usr/local/bin/uconsole-lowpower up >/dev/null 2>&1
        say "gauge $a1 -> $a2"
        echo
    fi

    echo "== s2idle"
    (( MODEM_LOW )) && { mmcli -m 0 --set-power-state-low >/dev/null 2>&1; say "modem radio set low"; }
    /usr/local/bin/uconsole-lowpower down >/dev/null 2>&1
    say "mem_sleep forced to: $(force_s2idle)"

    if (( PRINT_TIMES )); then
        # Makes the kernel print every device's suspend/resume timing. The LAST
        # device named before a hang is the culprit -- the only way to identify it
        # without a serial console, since the journal does not survive.
        echo 0 > /sys/power/pm_async 2>/dev/null
        echo 1 > /sys/power/pm_print_times 2>/dev/null
        say "pm_print_times on, async suspend off -- read the log for the last device"
    fi

    local b1 b2
    b1=$(read_gauge); rec "s2idle_before=$b1"
    crumb "run:s2idle"
    wd_raise $(( secs + 180 ))
    # Flush everything reachable before handing control to the kernel: if this
    # hangs, the battery comes out, and anything unwritten is lost.
    systemctl kill --signal=SIGUSR1 systemd-journald 2>/dev/null
    sync; sleep 2
    mark "run"
    say "suspending for ${MINUTES} min at $(date +%H:%M:%S) -- do not touch the machine"

    local rc t0 t1
    t0=$(date +%s)
    if (( WAKE_BUTTON )); then
        # No alarm at all: suspend and wait for the power key.
        say "PRESS THE POWER BUTTON to wake it. If nobody does, the watchdog resets it"
        say "at $(date -d "+$(( secs + 180 )) sec" +%H:%M:%S)."
        sync
        echo mem > /sys/power/state 2>/dev/null
        rc=$?
    else
        rtcwake -m mem -s "$secs" >/dev/null 2>&1
        rc=$?
    fi
    t1=$(date +%s)

    # RECORD FIRST, restore second. Everything below this line can hang; nothing
    # above it may be lost. The previous version called `lowpower up` before
    # writing anything down and the machine died with the numbers still in RAM.
    b2=$(read_gauge)
    rec "s2idle_after=$b2"
    rec "rtcwake_rc=$rc"
    # Wall time keeps running through s2idle here (timekeeping is never
    # suspended), so this is how long it actually slept. Short of --minutes
    # means something other than the alarm woke it; the log names the IRQ.
    rec "slept_s=$(( t1 - t0 ))"
    rec "wakeup_irq=$(cat /sys/power/pm_wakeup_irq 2>/dev/null || echo none)"
    rec "survived_wake=yes"
    wd_restore
    keep_log "run"

    /usr/local/bin/uconsole-lowpower up >/dev/null 2>&1

    # The display after resume.
    #
    # On a stock kernel RP1 is reset across the noirq cycle, and drm-rp1-dsi has
    # no PM ops: its DMA interrupt is enabled once, in rp1dsi_platform_probe()
    # (rp1dsi_mipicfg_setup), and never again. Every commit then waits out its
    # 10 s flip_done timeout. A VT bounce CANNOT fix that -- the modeset it forces
    # runs rp1dsi_dsi_setup(), which does not touch the interrupt enable. An
    # earlier version of this comment claimed it did; the source says otherwise.
    #
    # With keep_link_in_suspend RP1 is never reset, so there should be nothing
    # to repair. The bounce is still what re-enables a panel sway powered off.
    if (( PANEL_RESTORE )); then
        /usr/local/bin/uconsole-lowpower panel-on >/dev/null 2>&1
        rec "vt_bounce=done"
    fi
    modem_back
    wifi_back

    say "woke at $(date +%H:%M:%S) after $(( t1 - t0 ))s, rtcwake rc=$rc"
    say "gauge $b1 -> $b2"
    (( rc == 0 )) || say "NOTE: the suspend returned an error -- the core began unwinding."
    rec "restored=yes"
    rm -f "$BREADCRUMB"

    echo
    do_report_file "$secs" "$mode" "$vnow"
}

# Print the summary from the RESULTS file, so it can be recovered after a reboot.
do_report_file() {
    local secs="${1:-}" mode="${2:-}" vnow="${3:-}"
    [[ -r $RESULTS ]] || die "no results at $RESULTS"
    local v
    # One key per record, and take only the first whitespace-delimited token
    # after the '=': a stray second key on the same line ends up inside an
    # arithmetic expansion later and dies with "unbound variable".
    v() { awk -F'\t' -v k="$1" '$2 ~ "^"k"=" {split($2,a,"="); split(a[2],b," "); print b[1]}' "$RESULTS" | tail -1; }
    [[ -n $secs ]] || secs=$(( $(awk -F'minutes=' '/minutes=/{split($2,a," "); print a[1]; exit}' "$RESULTS") * 60 ))
    [[ -n $mode ]] || mode=$(awk -F'gauge=' '/gauge=/{split($2,a," "); print a[1]; exit}' "$RESULTS")
    [[ -n $vnow ]] || vnow=$(awk -F'voltage_uv=' '/voltage_uv=/{split($2,a," "); print a[1]; exit}' "$RESULTS")

    say "$(awk -F'\t' '$2 ~ /^kernel_switches/ {print $2}' "$RESULTS" | tail -1)"
    printf '  %-22s %12s %12s\n' phase delta "drain"
    printf '  %s\n' "----------------------------------------------"
    local a1 a2 b1 b2 slept ac
    a1=$(v awake_before); a2=$(v awake_after)
    b1=$(v s2idle_before); b2=$(v s2idle_after)
    slept=$(v slept_s); ac=$(awk -F'ac=' '/ac=/{split($2,a," "); print a[1]; exit}' "$RESULTS")
    [[ -n $a1 && -n $a2 ]] && report_phase "blanked, awake" "$a1" "$a2" "$secs" "$mode" "$vnow"
    if [[ -n $b1 && -n $b2 ]]; then
        if [[ $ac == 1 ]]; then
            printf '  %-22s %s\n' "s2idle" "survived ${slept:-?}s on AC -- no drain figure"
        else
            report_phase "s2idle" "$b1" "$b2" "${slept:-$secs}" "$mode" "$vnow"
        fi
    else
        printf '  %-22s %s\n' "s2idle" "NO RESULT -- the machine did not survive the suspend"
    fi
    echo
    echo "  Only the DIFFERENCE is meaningful. Expect it to be small: Pi 5 has no"
    echo "  cpuidle driver, so there are no C-states for s2idle to enter."
}

report_phase() {  # label before after secs mode voltage_uv
    local label="$1" before="$2" after="$3" secs="$4" mode="$5" vnow="${6:-0}"
    local d=$(( before - after ))
    # A zero delta is NOT zero draw -- it means the counter did not tick inside
    # the window. axp20x's energy_now is coarse enough that a one-minute phase
    # can begin and end on the same value, which would otherwise be reported as
    # a confident and completely wrong "0.000 W".
    if (( d <= 0 )); then
        printf '  %-22s %s\n' "$label" \
            "no change over ${secs}s -- window too short for this gauge to resolve"
        return
    fi
    case "$mode" in
        energy)  printf '  %-22s %9s uWh %8.3f W\n' "$label" "$d" \
                     "$(awk "BEGIN{print $d*3600/$secs/1000000}")" ;;
        charge)  printf '  %-22s %9s uAh %8.3f W\n' "$label" "$d" \
                     "$(awk "BEGIN{v=$vnow/1000000; print $d*3600/$secs*v/1000000}")" ;;
        voltage) printf '  %-22s %9s uV  %8s\n' "$label" "$d" "(noisy)" ;;
    esac
}

### wake-check ---------------------------------------------------------------
# Does the wake path work AT ALL? Zero risk -- this never suspends.
#
# The first version watched /proc/interrupts for an RTC line. rtc-rpi has no
# interrupt, so there is never a line to watch, and it would have reported "did
# not fire" by construction. What an alarm does leave behind, once patch 0005
# delivers it, is the RTC core clearing the alarm it has handled -- so read that.
do_wake_check() {
    need_root
    echo "== wakeup sources the kernel has registered"
    for w in /sys/class/wakeup/*; do
        [[ -r $w/name ]] || continue
        printf '   %-32s events=%s\n' "$(cat "$w/name")" \
               "$(cat "$w/event_count" 2>/dev/null || echo '?')"
    done

    echo "== power button"
    local pek found=0
    for pek in /sys/bus/platform/devices/*pek*/power/wakeup; do
        [[ -r $pek ]] || continue
        found=1
        printf '   %s = %s\n' "$pek" "$(cat "$pek")"
    done
    (( found )) || say "no axp pek wakeup attribute found"
    local line; line=$(awk '$NF == "axp22x_irq_chip"' /proc/interrupts | head -1)
    say "AXP223 interrupt: ${line:-not found}"
    if [[ $line == *pinctrl-rp1* ]]; then
        say "an RP1 GPIO: the key can wake the machine only with gpio_wake=Y and"
        say "keep_link_in_suspend=Y (now: $(cat "$KP_WAKE" 2>/dev/null || echo absent) /" \
            "$(cat "$KP_LINK" 2>/dev/null || echo absent))"
    fi

    echo "== RTC alarm, tested without suspending"
    local rtc=/sys/class/rtc/rtc0
    if [[ ! -w $rtc/wakealarm ]]; then
        no "no writable $rtc/wakealarm -- rtcwake cannot arm anything"
        return 1
    fi
    if [[ -w $KP_RTC ]]; then
        KP_SAVED[$KP_RTC]=$(cat "$KP_RTC")
        echo Y > "$KP_RTC"
        say "emulate_alarm_irq on for this test (was ${KP_SAVED[$KP_RTC]})"
    else
        say "emulate_alarm_irq absent (no patch 0005): expect nothing to fire"
    fi
    echo 0 > "$rtc/wakealarm" 2>/dev/null
    echo "+10" > "$rtc/wakealarm" 2>/dev/null
    local armed; armed=$(cat "$rtc/wakealarm" 2>/dev/null)
    if [[ -z $armed || $armed == 0 ]]; then
        no "alarm would not arm (wakealarm reads '${armed:-empty}')"
        return 1
    fi
    ok "alarm armed for $armed; waiting 15s to see whether it fires"
    sleep 15
    # The RTC core disarms an alarm once it has DELIVERED it. An alarm that never
    # raised anything is still sitting there, in the past.
    local after; after=$(cat "$rtc/wakealarm" 2>/dev/null)
    if [[ -z $after ]]; then
        ok "the RTC alarm FIRED and was delivered -- rtcwake can end an s2idle"
    else
        no "the RTC alarm did NOT fire (wakealarm still reads $after)"
        say "rtcwake arms an alarm Linux never hears about: the machine suspends and"
        say "is never woken. Nothing else need be wrong with it."
    fi
    echo 0 > "$rtc/wakealarm" 2>/dev/null
}

### pstore -----------------------------------------------------------------
# The journal cannot survive a hang; a RAM console can. ramoops keeps the tail of
# the kernel log in a reserved region that is not cleared by a warm reset, so
# after the watchdog reboots the machine the last messages before the freeze --
# including pm_print_times naming the device that never finished -- are readable.
do_pstore() {
    if ! mountpoint -q /sys/fs/pstore 2>/dev/null && [[ ! -e /sys/fs/pstore/. ]]; then
        die "/sys/fs/pstore is not mounted; is the ramoops overlay enabled in config.txt?"
    fi
    # console-ramoops-0 is the one that matters for a hang. dmesg-ramoops-N only
    # exists if the kernel panicked or oopsed, and a hang does neither.
    local found=0
    for f in /sys/fs/pstore/console-ramoops-* /sys/fs/pstore/*; do
        [[ -e $f ]] || continue
        found=1
        echo "=== $f"
        # The suspend device order is what we are after; show the tail, which is
        # where the last device before the hang will be.
        tail -60 "$f"
        echo
    done
    if (( ! found )); then
        echo "/sys/fs/pstore is empty."
        echo
        echo "For a HANG this usually means the console ring is not enabled, not that"
        echo "nothing happened. ramoops' record-size buffer only receives an oops or"
        echo "panic dump, and a hang produces neither -- nor does a watchdog reset,"
        echo "which just restarts the CPU with no chance to save anything."
        echo
        echo "config.txt needs the console ring turned on explicitly:"
        echo "    dtoverlay=ramoops-pi5,console-size=0x8000"
        echo
        echo "Currently: $(grep -o 'dtoverlay=ramoops[^ ]*' /boot/config.txt 2>/dev/null || echo 'no ramoops overlay')"
        echo "Reserved:  $(dmesg 2>/dev/null | grep -i -m1 ramoops || echo 'no ramoops line in dmesg')"
        return 1
    fi
    echo "Clear these with: sudo rm -f /sys/fs/pstore/*"
}

### dispatch ----------------------------------------------------------------
CMD="${1:-}"; shift 2>/dev/null || true
while [[ $# -gt 0 ]]; do
    case "$1" in
        --minutes) MINUTES="${2:?}"; shift ;;
        --with-fixes) WITH_FIXES=1 ;;
        --cycle-wifi) CYCLE_WIFI=1 ;;
        --wake-button) WAKE_BUTTON=1 ;;
        --allow-ac) ALLOW_AC=1 ;;
        --allow-wifi) ALLOW_WIFI=1 ;;
        --modem-low) MODEM_LOW=1 ;;
        --print-times) PRINT_TIMES=1 ;;
        --no-panel-restore) PANEL_RESTORE=0 ;;
        --yes-i-may-lose-this-boot) CONFIRM=1 ;;
        *) die "unknown option: $1" ;;
    esac
    shift
done

case "$CMD" in
    check)        do_check ;;
    report)       do_report_file ;;
    pstore)       do_pstore ;;
    wake-check)   trap fixes_restore EXIT; do_wake_check ;;
    unload-wifi)  do_unload_wifi ;;
    restore-wifi) do_restore_wifi ;;
    bisect)       trap cleanup EXIT; do_bisect ;;
    run)          trap cleanup EXIT; do_run ;;
    *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
       echo; echo "Options: --minutes N  --with-fixes  --cycle-wifi  --wake-button  --allow-ac
         --modem-low  --print-times  --no-panel-restore  --allow-wifi
         --yes-i-may-lose-this-boot"
       exit 2 ;;
esac
