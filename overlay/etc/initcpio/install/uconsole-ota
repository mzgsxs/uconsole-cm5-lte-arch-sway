#!/bin/bash
# mkinitcpio install hook: put the OTA recovery check into the initramfs.
#
# Paired with the `systemd` hook, so the check is a systemd unit rather than a
# run_hook function -- this initramfs runs systemd in early userspace, not the
# busybox init, and the two mechanisms are not interchangeable.

build() {
    add_binary /usr/local/bin/uconsole-ota-recovery
    # Explicit rather than assumed: the recovery path needs these, and relying on
    # another hook happening to pull them in is how a working initramfs quietly
    # becomes a broken one after an unrelated change.
    add_binary dd
    add_binary gzip
    add_binary mount
    add_binary umount
    add_module 'vfat'
    add_module 'nls_cp437'
    add_module 'nls_iso8859-1'

    add_systemd_unit uconsole-ota-recovery.service
    # Nothing pulls the unit in by dependency, so wire it to the initrd target
    # explicitly.
    add_symlink /usr/lib/systemd/system/initrd-root-fs.target.wants/uconsole-ota-recovery.service \
                ../uconsole-ota-recovery.service
}

help() {
    cat <<'HELPEOF'
Adds the uConsole OTA recovery check to the initramfs. Phase 0 observes only:
it reports whether /boot carries an OTA-PENDING marker and always falls through
to a normal boot.
HELPEOF
}
