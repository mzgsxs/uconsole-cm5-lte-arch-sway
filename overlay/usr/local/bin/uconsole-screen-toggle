#!/usr/bin/env bash
# Toggle the panel backlight. Bound to a short power-key press.
#
# Going down it also locks the session and silences the keyboard and trackball,
# so the device can sit in a bag without stray keypresses reaching whatever was
# on screen. Coming back up it restores everything and swaylock asks for the
# password.
#
# Deliberately drives the BACKLIGHT and not `output dpms off`: on this cwu50 DSI
# panel a dpms power-down has been observed never to come back (report S3.8),
# which presents as a hung machine.
set -uo pipefail
STATE=/run/user/$(id -u)/uconsole-backlight.save

cur=$(brightnessctl get 2>/dev/null || echo 0)
max=$(brightnessctl max 2>/dev/null || echo 0)

# Emit sway input identifiers.
#
# mode=pointers deliberately covers ONLY pointer-like devices, never keyboards.
# The power key arrives as a keyboard-type device, and its identifier is not
# something this script can reliably predict -- disabling keyboards risked
# silencing the one device that can bring the machine back. Keyboard input is
# not a real hazard anyway: while swaylock holds the session, keystrokes go to
# the password prompt and cannot reach whatever was on screen. The trackball is
# the input that actually matters here, since a ball rolling in a bag is what
# generates spurious events.
list_inputs() {
    command -v swaymsg >/dev/null 2>&1 || return 0
    swaymsg -t get_inputs -r 2>/dev/null | python3 -c '
import json, sys
mode = sys.argv[1] if len(sys.argv) > 1 else "all"
POINTERS = ("pointer", "touchpad", "touch", "tablet_tool")
ALL = POINTERS + ("keyboard",)
try:
    devs = json.load(sys.stdin)
except Exception:
    sys.exit(0)
wanted = POINTERS if mode == "pointers" else ALL
for d in devs:
    if d.get("type") in wanted:
        print(d.get("identifier", ""))
' "$1" 2>/dev/null
}

set_inputs() {   # $1 = enabled|disabled   $2 = all|pointers
    local ident
    while read -r ident; do
        [[ -n $ident ]] && swaymsg input "$ident" events "$1" >/dev/null 2>&1
    done < <(list_inputs "$2")
}

lock_session() {
    command -v swaylock >/dev/null 2>&1 || {
        logger -t uconsole-screen-toggle "WARNING: swaylock not installed; blanking WITHOUT locking"
        return 0
    }
    pgrep -x swaylock >/dev/null 2>&1 && return 0
    # -f daemonises; without it this script would block until unlocked and the
    # backlight would never go off.
    if ! swaylock -f -c 000000 >/dev/null 2>&1; then
        logger -t uconsole-screen-toggle "WARNING: swaylock failed to start; screen blanked WITHOUT locking"
    fi
}

if [[ ${cur:-0} -gt 0 ]]; then
    echo "$cur" > "$STATE" 2>/dev/null || true
    # Lock before blanking so the desktop is never briefly visible on wake.
    lock_session
    set_inputs disabled pointers
    brightnessctl set 0 >/dev/null 2>&1
    logger -t uconsole-screen-toggle "blanked, locked, pointer input silenced"
else
    # Re-enable EVERY input, not just what we silenced. If anything went wrong on
    # the way down, this is the path that has to recover it -- an input left
    # disabled with no keyboard is unrecoverable without a reboot.
    set_inputs enabled all
    if [[ -r $STATE ]]; then
        brightnessctl set "$(cat "$STATE")" >/dev/null 2>&1
    else
        brightnessctl set "$(( max * 40 / 100 ))" >/dev/null 2>&1
    fi
    logger -t uconsole-screen-toggle "woken, input restored"
fi
